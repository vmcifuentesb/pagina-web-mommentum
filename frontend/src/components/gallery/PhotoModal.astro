---
// Fullscreen Photographic Lightbox Modal with Next / Prev Navigation
---

<div id="global-photo-modal" class="fixed inset-0 z-[99990] bg-obsidian/95 backdrop-blur-2xl hidden items-center justify-center p-4 md:p-10 select-none">
  
  <!-- Close Button (Top Right) -->
  <button id="close-lightbox-btn" class="absolute top-6 right-6 z-50 w-12 h-12 rounded-full border border-white/20 hover:border-white flex items-center justify-center text-white hover:bg-white hover:text-black transition-all font-mono text-sm" aria-label="Cerrar [ESC]" data-cursor="pointer">
    ✕
  </button>

  <!-- Left Arrow Button (Previous Photo) -->
  <button 
    id="lightbox-prev-btn" 
    class="absolute left-4 sm:left-6 top-1/2 -translate-y-1/2 z-50 w-12 sm:w-14 h-24 rounded-lg bg-carbon/80 hover:bg-white text-white hover:text-black backdrop-blur-md border border-white/15 flex items-center justify-center transition-all group"
    aria-label="Foto Anterior [←]"
    data-cursor="pointer"
  >
    <svg class="w-8 h-8 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
    </svg>
  </button>

  <!-- Right Arrow Button (Next Photo) -->
  <button 
    id="lightbox-next-btn" 
    class="absolute right-4 sm:right-6 top-1/2 -translate-y-1/2 z-50 w-12 sm:w-14 h-24 rounded-lg bg-carbon/80 hover:bg-white text-white hover:text-black backdrop-blur-md border border-white/15 flex items-center justify-center transition-all group"
    aria-label="Foto Siguiente [→]"
    data-cursor="pointer"
  >
    <svg class="w-8 h-8 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
    </svg>
  </button>

  <!-- Main Modal Container Full Width -->
  <div class="relative w-full h-full max-h-[92vh] flex flex-col md:flex-row items-center justify-between gap-6 md:gap-8 px-12 sm:px-16">
    
    <!-- Large Photo Frame -->
    <div class="relative flex-1 w-full h-full flex items-center justify-center overflow-hidden">
      <img 
        id="lightbox-img" 
        src="" 
        alt="" 
        class="max-w-full max-h-full object-contain filter contrast-105 shadow-2xl rounded-lg transition-opacity duration-200" 
      />
    </div>

    <!-- Curatorial & Technical Sidebar Full Width Info -->
    <div class="w-full md:w-80 flex-shrink-0 font-mono text-xs text-silver space-y-5 border-t md:border-t-0 md:border-l border-white/10 pt-4 md:pt-0 md:pl-8 bg-carbon/60 p-5 md:bg-transparent rounded-xl">
      <div>
        <div class="flex items-center justify-between font-mono text-[10px] text-graphite uppercase tracking-widest mb-1">
          <span>// FICHA TÉCNICA</span>
          <span id="lightbox-counter" class="text-white font-bold">FOTO 01 / 01</span>
        </div>
        <h3 id="lightbox-title" class="font-condensed text-3xl font-bold uppercase text-white leading-tight">
          -
        </h3>
        <p id="lightbox-copy" class="font-body text-xs text-silver/90 mt-1">
          -
        </p>
      </div>

      <div class="space-y-2.5 border-t border-white/10 pt-4 text-xs">
        <div class="flex justify-between">
          <span class="text-graphite">ÁLBUM:</span>
          <span id="lightbox-album" class="text-white font-bold">-</span>
        </div>
        <div class="flex justify-between">
          <span class="text-graphite">OBTURACIÓN:</span>
          <span id="lightbox-shutter" class="text-white font-bold">-</span>
        </div>
        <div class="flex justify-between">
          <span class="text-graphite">APERTURA:</span>
          <span id="lightbox-aperture" class="text-white font-bold">-</span>
        </div>
        <div class="flex justify-between">
          <span class="text-graphite">SENSIBILIDAD:</span>
          <span id="lightbox-iso" class="text-white font-bold">-</span>
        </div>
        <div class="flex justify-between">
          <span class="text-graphite">DIMENSIONES:</span>
          <span id="lightbox-dim" class="text-white font-bold">-</span>
        </div>
      </div>

      <div class="pt-3 border-t border-white/10 text-[10px] text-graphite flex items-center justify-between">
        <span>TECLAS ← / → PARA NAVEGAR</span>
        <span>ESC: SALIR</span>
      </div>
    </div>

  </div>

</div>

<script>
  const modal = document.getElementById('global-photo-modal');
  const closeBtn = document.getElementById('close-lightbox-btn');
  const prevBtn = document.getElementById('lightbox-prev-btn');
  const nextBtn = document.getElementById('lightbox-next-btn');

  const imgElem = document.getElementById('lightbox-img') as HTMLImageElement;
  const counterElem = document.getElementById('lightbox-counter');
  const titleElem = document.getElementById('lightbox-title');
  const copyElem = document.getElementById('lightbox-copy');
  const albumElem = document.getElementById('lightbox-album');
  const shutterElem = document.getElementById('lightbox-shutter');
  const apertureElem = document.getElementById('lightbox-aperture');
  const isoElem = document.getElementById('lightbox-iso');
  const dimElem = document.getElementById('lightbox-dim');

  let currentPhotoList: any[] = [];
  let currentIndex = 0;

  const renderCurrentPhoto = () => {
    if (currentPhotoList.length === 0) return;
    const data = currentPhotoList[currentIndex];
    if (!data) return;

    if (imgElem) {
      imgElem.style.opacity = '0.3';
      imgElem.src = data.url || '';
      imgElem.alt = data.title || '';
      setTimeout(() => {
        imgElem.style.opacity = '1';
      }, 50);
    }

    if (counterElem) counterElem.textContent = `FOTO 0${currentIndex + 1} / 0${currentPhotoList.length}`;
    if (titleElem) titleElem.textContent = data.title || 'MOMMENTUM';
    if (copyElem) copyElem.textContent = data.copy || '';
    if (albumElem) albumElem.textContent = data.album || 'MOMMENTUM';
    if (shutterElem) shutterElem.textContent = data.shutter || '1/250s';
    if (apertureElem) apertureElem.textContent = data.aperture || 'f/2.8';
    if (isoElem) isoElem.textContent = data.iso || 'ISO 100';
    if (dimElem) dimElem.textContent = data.dim || '3840 × 2160';
  };

  const showNextPhoto = () => {
    if (currentPhotoList.length <= 1) return;
    currentIndex = (currentIndex + 1) % currentPhotoList.length;
    renderCurrentPhoto();
  };

  const showPrevPhoto = () => {
    if (currentPhotoList.length <= 1) return;
    currentIndex = (currentIndex - 1 + currentPhotoList.length) % currentPhotoList.length;
    renderCurrentPhoto();
  };

  const openModal = (targetUrl: string) => {
    if (!modal) return;

    // Collect all lightbox photo triggers currently on the page
    const triggers = Array.from(document.querySelectorAll('[data-lightbox-photo]'));
    currentPhotoList = triggers.map((el) => ({
      url: el.getAttribute('data-url') || (el as HTMLImageElement).src || '',
      title: el.getAttribute('data-title') || '',
      copy: el.getAttribute('data-copy') || '',
      album: el.getAttribute('data-album') || '',
      shutter: el.getAttribute('data-shutter') || '',
      aperture: el.getAttribute('data-aperture') || '',
      iso: el.getAttribute('data-iso') || '',
      dim: el.getAttribute('data-dim') || '',
    })).filter(p => p.url !== '');

    const foundIdx = currentPhotoList.findIndex(p => p.url === targetUrl);
    currentIndex = foundIdx !== -1 ? foundIdx : 0;

    renderCurrentPhoto();

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  const closeModal = () => {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = 'auto';
  };

  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (prevBtn) prevBtn.addEventListener('click', showPrevPhoto);
  if (nextBtn) nextBtn.addEventListener('click', showNextPhoto);

  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  }

  // Keyboard navigation for Modal
  window.addEventListener('keydown', (e) => {
    if (modal && !modal.classList.contains('hidden')) {
      if (e.key === 'Escape') closeModal();
      if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') showNextPhoto();
      if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') showPrevPhoto();
    }
  });

  // Attach click listener to all trigger elements
  const attachTriggers = () => {
    document.querySelectorAll('[data-lightbox-photo]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        const url = el.getAttribute('data-url') || (el as HTMLImageElement).src || '';
        if (url) openModal(url);
      });
    });
  };

  attachTriggers();
  document.addEventListener('astro:page-load', attachTriggers);
</script>
