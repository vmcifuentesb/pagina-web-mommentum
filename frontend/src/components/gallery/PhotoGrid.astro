---
import { PHOTOS } from '../../data/portfolio';
---

<section id="galeria" class="relative w-full py-28 bg-obsidian text-pure overflow-hidden border-t border-white/5">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <!-- Header & Filter Bar -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-16">
      <div>
        <span class="font-mono text-xs tracking-[0.25em] text-graphite uppercase">// CATÁLOGO DE OBRAS</span>
        <h2 class="font-condensed text-4xl sm:text-6xl md:text-7xl uppercase font-bold tracking-tight text-pure mt-2">
          GALERÍA DE AUTOR
        </h2>
      </div>

      <!-- Filter Buttons -->
      <div class="flex flex-wrap items-center gap-2 font-mono text-[11px] uppercase tracking-wider">
        <button class="filter-btn active px-4 py-2 rounded bg-pure text-obsidian font-bold transition-all" data-filter="all" data-cursor="pointer">
          TODAS (6)
        </button>
        <button class="filter-btn px-4 py-2 rounded border border-white/10 text-graphite hover:text-pure hover:border-white/30 transition-all" data-filter="dinamismo" data-cursor="pointer">
          DINAMISMO
        </button>
        <button class="filter-btn px-4 py-2 rounded border border-white/10 text-graphite hover:text-pure hover:border-white/30 transition-all" data-filter="luz" data-cursor="pointer">
          LUZ & ATMÓSFERA
        </button>
        <button class="filter-btn px-4 py-2 rounded border border-white/10 text-graphite hover:text-pure hover:border-white/30 transition-all" data-filter="composicion" data-cursor="pointer">
          COMPOSICIÓN
        </button>
      </div>
    </div>

    <!-- Masonry Grid Layout -->
    <div id="photos-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {PHOTOS.map((photo, index) => (
        <article 
          class="photo-card group relative bg-carbon rounded-lg overflow-hidden border border-white/5 hover:border-white/20 transition-all duration-500 cursor-pointer"
          data-pillar={photo.pillar}
          data-photo-id={photo.id}
          data-cursor="view"
        >
          <!-- Image Container -->
          <div class="relative aspect-[4/5] w-full overflow-hidden bg-obsidian">
            <img 
              src={photo.imageUrl} 
              alt={photo.title}
              class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 filter grayscale contrast-125 group-hover:grayscale-0 group-hover:contrast-100 transition-filter"
              loading="lazy"
            />
            
            <!-- Vignette & Monochromatic Shade -->
            <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-transparent to-transparent opacity-80 group-hover:opacity-40 transition-opacity duration-300"></div>

            <!-- Top Badge (Pillar & Series) -->
            <div class="absolute top-4 left-4 right-4 flex items-center justify-between pointer-events-none">
              <span class="px-2.5 py-1 rounded bg-obsidian/70 backdrop-blur-md border border-white/10 font-mono text-[9px] tracking-widest text-silver uppercase">
                SERIE {photo.seriesNumber}
              </span>
              <span class="px-2.5 py-1 rounded bg-obsidian/70 backdrop-blur-md border border-white/10 font-mono text-[9px] tracking-widest text-graphite uppercase">
                {photo.year}
              </span>
            </div>

            <!-- Quick EXIF Pill -->
            <div class="absolute bottom-4 left-4 font-mono text-[10px] text-graphite tracking-widest uppercase bg-obsidian/80 px-3 py-1 rounded backdrop-blur-md border border-white/10 group-hover:text-pure transition-colors">
              {photo.exif.aperture} • {photo.exif.shutterSpeed} • {photo.exif.focalLength}
            </div>
          </div>

          <!-- Card Content Info -->
          <div class="p-6 flex flex-col justify-between">
            <div>
              <span class="font-mono text-[10px] tracking-widest text-graphite uppercase">
                {photo.pillarLabel}
              </span>
              <h3 class="font-condensed text-2xl font-bold uppercase text-pure group-hover:text-silver transition-colors mt-1">
                {photo.title}
              </h3>
            </div>
            
            <p class="font-body text-xs text-graphite group-hover:text-silver/80 mt-3 line-clamp-2 transition-colors">
              {photo.concept}
            </p>

            <div class="mt-4 pt-4 border-t border-white/5 flex items-center justify-between font-mono text-[10px] text-silver tracking-widest uppercase">
              <span>INSPECCIONAR FICHA</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  // Filter Buttons Interactivity
  const filterBtns = document.querySelectorAll('.filter-btn');
  const photoCards = document.querySelectorAll('.photo-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('active', 'bg-pure', 'text-obsidian', 'font-bold');
        b.classList.add('text-graphite', 'border-white/10');
      });
      btn.classList.add('active', 'bg-pure', 'text-obsidian', 'font-bold');
      btn.classList.remove('text-graphite', 'border-white/10');

      const filter = btn.getAttribute('data-filter');

      photoCards.forEach(card => {
        const pillar = card.getAttribute('data-pillar');
        if (filter === 'all' || pillar === filter) {
          gsap.to(card, {
            autoAlpha: 1,
            scale: 1,
            duration: 0.4,
            display: 'block',
            ease: 'power2.out'
          });
        } else {
          gsap.to(card, {
            autoAlpha: 0,
            scale: 0.95,
            duration: 0.3,
            display: 'none',
            ease: 'power2.in'
          });
        }
      });
    });
  });
</script>
