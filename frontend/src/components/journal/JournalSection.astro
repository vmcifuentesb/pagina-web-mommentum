---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---

<section id="journal" class="relative w-full py-28 bg-obsidian text-pure overflow-hidden border-t border-white/5">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
      <div>
        <span class="font-mono text-xs tracking-[0.25em] text-graphite uppercase">// ESCRITOS & CRÓNICAS</span>
        <h2 class="font-condensed text-4xl sm:text-6xl md:text-7xl uppercase font-bold tracking-tight text-pure mt-2">
          JOURNAL DE AUTOR
        </h2>
      </div>
      <div>
        <p class="font-mono text-xs text-graphite max-w-sm">
          REFLEXIONES EDITORIALES, CONCEPTOS DE ILUMINACIÓN Y DIARIOS DE PRODUCCIÓN.
        </p>
      </div>
    </div>

    <!-- Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sortedPosts.map((post) => (
        <a 
          href={`/blog/${post.slug}`} 
          class="group block bg-carbon p-8 rounded border border-white/5 hover:border-white/20 transition-all duration-300 flex flex-col justify-between"
          data-cursor="pointer"
        >
          <div>
            <div class="flex items-center justify-between font-mono text-[10px] text-graphite tracking-widest uppercase mb-4">
              <span>{new Date(post.data.pubDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
              <span>POR {post.data.author}</span>
            </div>

            <h3 class="font-condensed text-2xl font-bold uppercase text-pure group-hover:text-silver transition-colors leading-tight">
              {post.data.title}
            </h3>

            <p class="font-body text-xs text-graphite group-hover:text-silver/80 mt-4 leading-relaxed transition-colors">
              {post.data.description}
            </p>
          </div>

          <div class="mt-8 pt-4 border-t border-white/5 flex items-center justify-between font-mono text-[10px] text-silver tracking-widest uppercase">
            <span>LEER CRÓNICA COMPLETA</span>
            <span class="group-hover:translate-x-2 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
