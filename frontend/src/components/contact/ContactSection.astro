---
// Editorial Contact & Booking Inquiry Component
---

<section id="contacto" class="relative w-full py-32 bg-obsidian text-pure overflow-hidden border-t border-white/5">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
      
      <!-- Left Column: Info & Manifesto -->
      <div class="lg:col-span-5 flex flex-col justify-between">
        <div>
          <span class="font-mono text-xs tracking-[0.25em] text-graphite uppercase">// COMISIONES & PROYECTOS</span>
          <h2 class="font-condensed text-4xl sm:text-6xl md:text-7xl uppercase font-bold tracking-tight text-pure mt-2 leading-none">
            INICIAR <br />DIÁLOGO.
          </h2>
          <p class="font-body text-sm md:text-base text-silver/80 mt-6 leading-relaxed">
            Aceptamos un número limitado de comisiones editoriales, retratos conceptuales y colaboraciones artísticas cada temporada para preservar la dedicación artesanal de cada obra.
          </p>

          <div class="mt-12 space-y-6 font-mono text-xs text-graphite">
            <div class="flex items-center gap-4">
              <span class="w-8 text-pure">INSTAGRAM:</span>
              <a href="https://www.instagram.com/mommentum.ises/" target="_blank" rel="noopener noreferrer" class="text-silver hover:text-pure underline transition-colors" data-cursor="pointer">
                @mommentum.ises
              </a>
            </div>
            <div class="flex items-center gap-4">
              <span class="w-8 text-pure">CORREO:</span>
              <a href="mailto:contacto@mommentum.ises" class="text-silver hover:text-pure underline transition-colors" data-cursor="pointer">
                contacto@mommentum.ises
              </a>
            </div>
            <div class="flex items-center gap-4">
              <span class="w-8 text-pure">ESTUDIO:</span>
              <span class="text-silver">Ciudad de México • Disponible Globalmente</span>
            </div>
          </div>
        </div>

        <div class="mt-12 pt-8 border-t border-white/10 font-mono text-[10px] text-graphite">
          <p>TIEMPO ESTIMADO DE RESPUESTA: 24-48 HORAS</p>
        </div>
      </div>

      <!-- Right Column: Interactive Inquiry Form -->
      <div class="lg:col-span-7 bg-carbon p-8 md:p-12 rounded border border-white/10">
        <form id="inquiry-form" class="space-y-8">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block font-mono text-[10px] tracking-widest text-graphite uppercase mb-2">NOMBRE / ENTIDAD *</label>
              <input 
                type="text" 
                id="name" 
                required 
                placeholder="Tu nombre completo" 
                class="w-full bg-obsidian border border-white/10 focus:border-pure px-4 py-3 text-pure font-body text-sm rounded outline-none transition-colors"
              />
            </div>
            <div>
              <label for="email" class="block font-mono text-[10px] tracking-widest text-graphite uppercase mb-2">CORREO ELECTRÓNICO *</label>
              <input 
                type="email" 
                id="email" 
                required 
                placeholder="tu@correo.com" 
                class="w-full bg-obsidian border border-white/10 focus:border-pure px-4 py-3 text-pure font-body text-sm rounded outline-none transition-colors"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="project-type" class="block font-mono text-[10px] tracking-widest text-graphite uppercase mb-2">TIPO DE PROYECTO</label>
              <select 
                id="project-type" 
                class="w-full bg-obsidian border border-white/10 focus:border-pure px-4 py-3 text-pure font-body text-sm rounded outline-none transition-colors"
              >
                <option value="retrato">Retrato de Autor / Identidad</option>
                <option value="editorial">Comisión Editorial / Conceptual</option>
                <option value="adquisicion">Adquisición de Obra / Fine Art</option>
                <option value="colaboracion">Colaboración Institucional / Galería</option>
              </select>
            </div>
            <div>
              <label for="timeframe" class="block font-mono text-[10px] tracking-widest text-graphite uppercase mb-2">TEMPORALIDAD ESTIMADA</label>
              <input 
                type="text" 
                id="timeframe" 
                placeholder="Ej. Octubre 2026 / Inmediato" 
                class="w-full bg-obsidian border border-white/10 focus:border-pure px-4 py-3 text-pure font-body text-sm rounded outline-none transition-colors"
              />
            </div>
          </div>

          <div>
            <label for="message" class="block font-mono text-[10px] tracking-widest text-graphite uppercase mb-2">VISIÓN Y DETALLES DEL PROYECTO *</label>
            <textarea 
              id="message" 
              rows="4" 
              required 
              placeholder="Describe la atmósfera, el concepto o las preguntas sobre tu proyecto..." 
              class="w-full bg-obsidian border border-white/10 focus:border-pure px-4 py-3 text-pure font-body text-sm rounded outline-none transition-colors resize-none"
            ></textarea>
          </div>

          <button 
            type="submit" 
            class="w-full py-4 bg-pure text-obsidian hover:bg-gallery font-condensed tracking-[0.2em] text-sm uppercase font-bold transition-all duration-300 hover:scale-[0.99] flex items-center justify-center gap-3"
            data-cursor="pointer"
          >
            <span>ENVIAR SOLICITUD DE PROYECTO</span>
            <span class="font-mono">→</span>
          </button>

          <div id="form-feedback" class="hidden font-mono text-xs text-center p-3 rounded bg-white/5 border border-white/10 text-silver">
            ✅ Solicitud recibida. Nos comunicaremos contigo a la brevedad.
          </div>
        </form>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('inquiry-form');
  const feedback = document.getElementById('form-feedback');

  if (form && feedback) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      feedback.classList.remove('hidden');
      (form as HTMLFormElement).reset();
    });
  }
</script>
