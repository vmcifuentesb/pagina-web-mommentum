---
import type { PhotoItem, AlbumItem } from '../../data/albums';

interface Props {
  album: AlbumItem;
}

const { album } = Astro.props;
const photos = album.photos;
---

<div id="master-gallery" class="w-full select-none" data-cursor="pointer">
  
  <!-- View Mode Switcher -->
  <div class="w-full px-6 md:px-12 mb-6 flex items-center justify-between font-mono text-xs border-b border-white/10 pb-4">
    <div class="flex items-center gap-3">
      <span class="text-graphite uppercase">MODO DE VISTA:</span>
      <button id="view-slider-btn" class="px-3 py-1 rounded bg-pure text-obsidian font-bold transition-all" data-cursor="pointer">
        VISOR CINEMÁTICO (PANTALLA COMPLETA)
      </button>
      <button id="view-grid-btn" class="px-3 py-1 rounded border border-white/15 text-graphite hover:text-white transition-all" data-cursor="pointer">
        MOSAICO DE FOTOS ({photos.length})
      </button>
    </div>

    <div class="hidden sm:flex items-center gap-2 text-graphite text-[11px]">
      <span>USA LAS TECLAS</span>
      <kbd class="px-2 py-0.5 rounded bg-white/10 text-white font-bold">←</kbd>
      <kbd class="px-2 py-0.5 rounded bg-white/10 text-white font-bold">→</kbd>
      <span>O LA RUEDA DEL RATÓN PARA CAMBIAR DE FOTO</span>
    </div>
  </div>

  <!-- ========================================================= -->
  <!-- 1. MONUMENTAL FULLSCREEN STAGE (Primary Immersive Mode)   -->
  <!-- ========================================================= -->
  <div id="gallery-stage-container" class="relative w-full h-[78vh] sm:h-[82vh] bg-[#050608] border-y border-white/10 flex items-center justify-center overflow-hidden">
    
    <!-- Active Large Photo Display -->
    <div class="relative w-full h-full flex items-center justify-center p-4 md:p-8">
      <img 
        id="stage-active-img" 
        src={photos[0].url} 
        alt={photos[0].title} 
        class="max-w-full max-h-full object-contain filter contrast-105 drop-shadow-[0_0_50px_rgba(0,0,0,0.8)] cursor-zoom-in transition-transform duration-500 hover:scale-[1.01]"
        data-cursor="view"
      />
    </div>

    <!-- Navigation Arrows Left & Right -->
    <button 
      id="btn-stage-prev" 
      class="absolute left-4 top-1/2 -translate-y-1/2 w-14 h-24 rounded bg-obsidian/70 hover:bg-white text-white hover:text-black backdrop-blur-md border border-white/10 flex items-center justify-center transition-all z-20 group"
      aria-label="Foto Anterior"
      data-cursor="pointer"
    >
      <svg class="w-8 h-8 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>

    <button 
      id="btn-stage-next" 
      class="absolute right-4 top-1/2 -translate-y-1/2 w-14 h-24 rounded bg-obsidian/70 hover:bg-white text-white hover:text-black backdrop-blur-md border border-white/10 flex items-center justify-center transition-all z-20 group"
      aria-label="Foto Siguiente"
      data-cursor="pointer"
    >
      <svg class="w-8 h-8 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>

    <!-- Bottom HUD Bar on Stage -->
    <div class="absolute bottom-4 left-6 right-6 md:left-12 md:right-12 z-20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pointer-events-none">
      <div class="bg-obsidian/85 backdrop-blur-md px-4 py-2 rounded border border-white/15 pointer-events-auto">
        <div class="flex items-center gap-3 font-mono text-xs">
          <span id="stage-counter" class="text-white font-bold">FOTO 01 / 0{photos.length}</span>
          <span class="text-graphite">•</span>
          <span id="stage-title" class="text-silver font-bold uppercase">{photos[0].title}</span>
          <span class="text-graphite hidden md:inline">•</span>
          <span id="stage-specs" class="text-graphite text-[10px] hidden md:inline">{photos[0].shutter} • {photos[0].aperture} • {photos[0].iso}</span>
        </div>
      </div>

      <div class="flex items-center gap-3 pointer-events-auto">
        <button id="stage-expand-btn" class="px-4 py-2 rounded bg-obsidian/85 hover:bg-white text-white hover:text-black backdrop-blur-md border border-white/15 font-mono text-xs transition-all flex items-center gap-2" data-cursor="pointer">
          <span>🔍</span> PANTALLA COMPLETA
        </button>
      </div>
    </div>

  </div>

  <!-- Bottom Interactive Filmstrip Thumbnails Strip -->
  <div id="gallery-strip-container" class="w-full px-6 md:px-12 py-4 bg-obsidian border-b border-white/10">
    <div class="flex items-center gap-3 overflow-x-auto pb-2 scrollbar-thin">
      {photos.map((photo, pIdx) => (
        <button 
          class={`stage-thumb-btn flex-shrink-0 w-24 sm:w-28 aspect-[4/3] rounded overflow-hidden border transition-all cursor-pointer ${pIdx === 0 ? 'border-white scale-105' : 'border-white/20 opacity-50 hover:opacity-100'}`}
          data-index={pIdx}
          data-cursor="pointer"
        >
          <img src={photo.url} alt={photo.title} class="w-full h-full object-cover" loading="lazy" />
        </button>
      ))}
    </div>
  </div>

  <!-- ========================================================= -->
  <!-- 2. FULL-WIDTH GRID MOSAIC VIEW (Secondary High-Res Mode)  -->
  <!-- ========================================================= -->
  <div id="gallery-grid-container" class="w-full px-6 md:px-12 py-10 hidden">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      {photos.map((photo, pIdx) => (
        <div 
          class="group relative aspect-[4/3] rounded-lg overflow-hidden bg-carbon border border-white/15 hover:border-white transition-all cursor-pointer shadow-xl"
          data-lightbox-photo
          data-url={photo.url}
          data-title={photo.title}
          data-copy={photo.anitaCopy}
          data-album={album.title}
          data-shutter={photo.shutter}
          data-aperture={photo.aperture}
          data-iso={photo.iso}
          data-dim={photo.dimensions}
          data-cursor="view"
        >
          <img 
            src={photo.url} 
            alt={photo.title} 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-obsidian/90 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity p-4 flex flex-col justify-end">
            <span class="font-mono text-[10px] text-white font-bold">{photo.title}</span>
            <span class="font-mono text-[9px] text-silver/70">{photo.shutter} • {photo.aperture} • {photo.iso}</span>
          </div>
        </div>
      ))}
    </div>
  </div>

</div>

<script define:vars={{ photos, albumTitle: album.title }}>
  function initMasterGallery() {
    let activeIndex = 0;
    const stageImg = document.getElementById('stage-active-img');
    const stageCounter = document.getElementById('stage-counter');
    const stageTitle = document.getElementById('stage-title');
    const stageSpecs = document.getElementById('stage-specs');
    const btnPrev = document.getElementById('btn-stage-prev');
    const btnNext = document.getElementById('btn-stage-next');
    const btnExpand = document.getElementById('stage-expand-btn');
    const thumbBtns = document.querySelectorAll('.stage-thumb-btn');

    const viewSliderBtn = document.getElementById('view-slider-btn');
    const viewGridBtn = document.getElementById('view-grid-btn');
    const stageContainer = document.getElementById('gallery-stage-container');
    const stripContainer = document.getElementById('gallery-strip-container');
    const gridContainer = document.getElementById('gallery-grid-container');

  const updateStage = (index) => {
    if (index < 0) index = photos.length - 1;
    if (index >= photos.length) index = 0;
    activeIndex = index;

    const photo = photos[activeIndex];
    if (!photo) return;

    if (stageImg) {
      stageImg.style.opacity = '0.3';
      stageImg.src = photo.url;
      stageImg.alt = photo.title;
      setTimeout(() => {
        stageImg.style.opacity = '1';
      }, 50);
    }

    if (stageCounter) stageCounter.textContent = `FOTO 0${activeIndex + 1} / 0${photos.length}`;
    if (stageTitle) stageTitle.textContent = photo.title;
    if (stageSpecs) stageSpecs.textContent = `${photo.shutter} • ${photo.aperture} • ${photo.iso}`;

    thumbBtns.forEach((btn, idx) => {
      if (idx === activeIndex) {
        btn.classList.add('border-white', 'scale-105', 'opacity-100');
        btn.classList.remove('border-white/20', 'opacity-50');
        btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      } else {
        btn.classList.remove('border-white', 'scale-105', 'opacity-100');
        btn.classList.add('border-white/20', 'opacity-50');
      }
    });
  };

  if (btnPrev) btnPrev.addEventListener('click', () => updateStage(activeIndex - 1));
  if (btnNext) btnNext.addEventListener('click', () => updateStage(activeIndex + 1));

  thumbBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
      updateStage(idx);
    });
  });

  // Keyboard navigation
  window.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') updateStage(activeIndex - 1);
    if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') updateStage(activeIndex + 1);
  });

  // Mouse wheel navigation on stage
  if (stageContainer) {
    stageContainer.addEventListener('wheel', (e) => {
      e.preventDefault();
      if (e.deltaY > 20 || e.deltaX > 20) {
        updateStage(activeIndex + 1);
      } else if (e.deltaY < -20 || e.deltaX < -20) {
        updateStage(activeIndex - 1);
      }
    }, { passive: false });
  }

  // Fullscreen modal trigger
  const openLightbox = () => {
    const photo = photos[activeIndex];
    if (!photo) return;
    if (typeof window.openPhotoModal === 'function') {
      window.openPhotoModal(photo.url);
    }
  };

  if (stageImg) stageImg.addEventListener('click', openLightbox);
  if (btnExpand) btnExpand.addEventListener('click', openLightbox);

  // View switchers
  if (viewSliderBtn && viewGridBtn && stageContainer && stripContainer && gridContainer) {
    viewSliderBtn.addEventListener('click', () => {
      viewSliderBtn.classList.add('bg-pure', 'text-obsidian', 'font-bold');
      viewSliderBtn.classList.remove('border', 'border-white/15', 'text-graphite');
      viewGridBtn.classList.remove('bg-pure', 'text-obsidian', 'font-bold');
      viewGridBtn.classList.add('border', 'border-white/15', 'text-graphite');

      stageContainer.classList.remove('hidden');
      stripContainer.classList.remove('hidden');
      gridContainer.classList.add('hidden');
    });

    viewGridBtn.addEventListener('click', () => {
      viewGridBtn.classList.add('bg-pure', 'text-obsidian', 'font-bold');
      viewGridBtn.classList.remove('border', 'border-white/15', 'text-graphite');
      viewSliderBtn.classList.remove('bg-pure', 'text-obsidian', 'font-bold');
      viewSliderBtn.classList.add('border', 'border-white/15', 'text-graphite');

      stageContainer.classList.add('hidden');
      stripContainer.classList.add('hidden');
      gridContainer.classList.remove('hidden');
    });
  }
}

document.addEventListener('astro:page-load', initMasterGallery);
initMasterGallery();
</script>
