---
import type { PhotoItem } from '../../data/albums';

interface Props {
  photos: PhotoItem[];
}

const { photos } = Astro.props;
---

<div id="brutalist-wrapper" class="relative w-full py-6 select-none overflow-hidden" data-cursor="pointer">
  
  <!-- Subtle Helper Bar -->
  <div class="w-full px-6 md:px-12 mb-4 flex items-center justify-between font-mono text-xs text-graphite border-b border-white/10 pb-3">
    <span>COMPOSICIÓN ESCULTÓRICA ASIMÉTRICA ({photos.length} FOTOGRAFÍAS)</span>
    <span class="hidden sm:inline">USA LA RUEDA DEL RATÓN O LAS TECLAS ← / →</span>
  </div>

  <!-- Giant Asymmetric Horizontal Showcase Container -->
  <div id="brutalist-scroll-area" class="flex items-center gap-10 overflow-x-auto px-6 md:px-12 py-6 scrollbar-none scroll-smooth">
    {photos.map((photo, index) => {
      const isLarge = index % 2 === 0;
      return (
        <div 
          class={`brutalist-card flex-shrink-0 ${isLarge ? 'w-[88vw] sm:w-[740px] md:w-[860px]' : 'w-[75vw] sm:w-[580px] md:w-[680px]'} bg-carbon rounded-2xl p-4 md:p-6 border border-white/15 hover:border-white transition-all duration-500 shadow-2xl group cursor-pointer`}
          data-lightbox-photo
          data-url={photo.url}
          data-title={photo.title}
          data-copy={photo.anitaCopy}
          data-album={photo.albumSlug}
          data-shutter={photo.shutter}
          data-aperture={photo.aperture}
          data-iso={photo.iso}
          data-dim={photo.dimensions}
          data-cursor="view"
        >
          <!-- Top Sequence Tag -->
          <div class="flex items-center justify-between pb-3 mb-3 border-b border-white/10 font-mono text-[10px] text-graphite">
            <span class="text-white font-bold">SERIE 0{index + 1} / 0{photos.length}</span>
            <span class="text-silver uppercase">ALTA RESOLUCIÓN</span>
          </div>

          <!-- Monumental Photo Canvas -->
          <div class="relative w-full aspect-[16/10] sm:aspect-[16/9] rounded-xl overflow-hidden bg-obsidian mb-4">
            <img 
              src={photo.url} 
              alt={photo.title} 
              class="w-full h-full object-cover filter contrast-105 group-hover:scale-105 transition-transform duration-700" 
              loading="lazy"
            />
            <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
              <span class="px-5 py-2.5 bg-obsidian/90 backdrop-blur-md rounded font-mono text-xs text-white border border-white/30 font-bold">
                AMPLIAR A PANTALLA COMPLETA ↗
              </span>
            </div>
          </div>

          <!-- Bottom Metadata -->
          <div class="flex items-center justify-between font-mono text-xs pt-1">
            <div>
              <h3 class="font-condensed text-2xl font-bold text-white uppercase">{photo.title}</h3>
              <p class="font-body text-xs text-silver/80 mt-0.5">{photo.anitaCopy}</p>
            </div>
            <div class="text-right text-[11px] text-graphite hidden sm:block">
              <span class="text-white font-bold">{photo.shutter}</span> • <span>{photo.aperture}</span>
              <div class="text-silver">{photo.iso}</div>
            </div>
          </div>

        </div>
      );
    })}
  </div>

</div>

<script>
  const scrollArea = document.getElementById('brutalist-scroll-area');

  if (scrollArea) {
    let isWheeling = false;

    scrollArea.addEventListener('wheel', (e) => {
      e.preventDefault();
      if (isWheeling) return;

      const delta = e.deltaY || e.deltaX;
      const scrollStep = 760;

      if (Math.abs(delta) > 15) {
        isWheeling = true;
        scrollArea.scrollBy({
          left: delta > 0 ? scrollStep : -scrollStep,
          behavior: 'smooth'
        });

        setTimeout(() => {
          isWheeling = false;
        }, 220);
      }
    }, { passive: false });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') {
        scrollArea.scrollBy({ left: 760, behavior: 'smooth' });
      }
      if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') {
        scrollArea.scrollBy({ left: -760, behavior: 'smooth' });
      }
    });
  }
</script>
