---
import { PHOTOS } from '../../data/portfolio';
---

<div class="relative w-full h-[600px] md:h-[720px] bg-obsidian rounded-xl overflow-hidden border border-white/10 select-none">
  <!-- Three.js Canvas Container -->
  <div id="photo-cloud-canvas" class="w-full h-full cursor-grab active:cursor-grabbing" data-cursor="drag"></div>

  <!-- Top Hint Overlay -->
  <div class="absolute top-6 left-6 flex items-center gap-3 font-mono text-[10px] text-graphite uppercase tracking-widest bg-carbon/80 backdrop-blur-md px-4 py-2 rounded border border-white/10 pointer-events-none">
    <span class="w-2 h-2 rounded-full bg-pure animate-ping"></span>
    <span>NUBE 3D ORBITABLE • {PHOTOS.length} OBRAS EN EL ESPACIO</span>
  </div>

  <div class="absolute bottom-6 right-6 font-mono text-[10px] text-graphite uppercase bg-carbon/80 backdrop-blur-md px-4 py-2 rounded border border-white/10 pointer-events-none">
    ARRASTRA PARA ROTAR • CLIC EN OBRA PARA AMPLIAR
  </div>
</div>

<script>
  import * as THREE from 'three';
  import { PHOTOS } from '../../data/portfolio';

  const container = document.getElementById('photo-cloud-canvas');

  if (container) {
    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x0D0E11, 0.035);

    const camera = new THREE.PerspectiveCamera(50, container.clientWidth / container.clientHeight, 0.1, 100);
    camera.position.set(0, 0, 15);

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    const cloudGroup = new THREE.Group();
    scene.add(cloudGroup);

    const textureLoader = new THREE.TextureLoader();
    const photoMeshes: THREE.Mesh[] = [];

    // Distribute photos on a 3D Fibonacci Sphere
    const total = PHOTOS.length;
    const radius = 6.8;
    const phi = Math.PI * (3 - Math.sqrt(5)); // Golden angle

    PHOTOS.forEach((photo, i) => {
      const y = 1 - (i / (total - 1)) * 2; // y goes from 1 to -1
      const radiusAtY = Math.sqrt(1 - y * y);
      const theta = phi * i;

      const x = Math.cos(theta) * radiusAtY;
      const z = Math.sin(theta) * radiusAtY;

      const cardGeo = new THREE.PlaneGeometry(2.4, 3.0);
      const texture = textureLoader.load(photo.imageUrl);
      const cardMat = new THREE.MeshBasicMaterial({
        map: texture,
        side: THREE.DoubleSide,
      });

      const mesh = new THREE.Mesh(cardGeo, cardMat);
      mesh.position.set(x * radius, y * radius, z * radius);
      mesh.userData = { photoId: photo.id, title: photo.title };

      cloudGroup.add(mesh);
      photoMeshes.push(mesh);
    });

    // Raycasting for interactive click
    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2();

    // Orbit Dragging Physics
    let isDragging = false;
    let prevX = 0;
    let prevY = 0;
    let velX = 0;
    let velY = 0;
    let hasMoved = false;

    container.addEventListener('mousedown', (e) => {
      isDragging = true;
      hasMoved = false;
      prevX = e.clientX;
      prevY = e.clientY;
    });

    window.addEventListener('mouseup', (e) => {
      if (!isDragging) return;
      isDragging = false;

      // If clicked without dragging, check for raycast selection
      if (!hasMoved && container) {
        const rect = container.getBoundingClientRect();
        mouse.x = ((e.clientX - rect.left) / container.clientWidth) * 2 - 1;
        mouse.y = -((e.clientY - rect.top) / container.clientHeight) * 2 + 1;

        raycaster.setFromCamera(mouse, camera);
        const intersects = raycaster.intersectObjects(photoMeshes);

        if (intersects.length > 0) {
          const hit = intersects[0].object;
          const photoId = hit.userData.photoId;
          if (photoId) {
            const card = document.querySelector(`[data-photo-id="${photoId}"]`) as HTMLElement;
            if (card) card.click();
          }
        }
      }
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const deltaX = e.clientX - prevX;
      const deltaY = e.clientY - prevY;
      if (Math.abs(deltaX) > 3 || Math.abs(deltaY) > 3) hasMoved = true;
      prevX = e.clientX;
      prevY = e.clientY;

      velX = deltaX * 0.003;
      velY = deltaY * 0.003;
      cloudGroup.rotation.y += velX;
      cloudGroup.rotation.x += velY;
    });

    // Touch support
    container.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        isDragging = true;
        prevX = e.touches[0].clientX;
        prevY = e.touches[0].clientY;
      }
    });

    window.addEventListener('touchend', () => { isDragging = false; });

    window.addEventListener('touchmove', (e) => {
      if (!isDragging || e.touches.length !== 1) return;
      const deltaX = e.touches[0].clientX - prevX;
      const deltaY = e.touches[0].clientY - prevY;
      prevX = e.touches[0].clientX;
      prevY = e.touches[0].clientY;

      velX = deltaX * 0.004;
      velY = deltaY * 0.004;
      cloudGroup.rotation.y += velX;
      cloudGroup.rotation.x += velY;
    });

    // Animation Loop
    const animate = () => {
      requestAnimationFrame(animate);

      // Inertia and continuous ambient rotation
      if (!isDragging) {
        velX *= 0.95;
        velY *= 0.95;
        cloudGroup.rotation.y += velX + 0.0015;
        cloudGroup.rotation.x += velY;
      }

      // Billboarding: make all planes face camera
      photoMeshes.forEach(mesh => {
        mesh.lookAt(camera.position);
      });

      renderer.render(scene, camera);
    };

    animate();

    window.addEventListener('resize', () => {
      if (!container) return;
      camera.aspect = container.clientWidth / container.clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(container.clientWidth, container.clientHeight);
    });
  }
</script>
