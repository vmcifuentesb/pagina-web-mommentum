---
// 3D Interactive Studio Lighting & Chiaroscuro Simulator (Three.js)
---

<div class="relative w-full h-[540px] md:h-[640px] bg-obsidian rounded-xl overflow-hidden border border-white/10 select-none">
  <!-- Three.js Canvas Container -->
  <div id="light-sim-canvas" class="w-full h-full cursor-grab active:cursor-grabbing" data-cursor="drag"></div>

  <!-- Real-time Control HUD Overlay -->
  <div class="absolute top-6 left-6 max-w-xs p-5 rounded-lg bg-carbon/80 backdrop-blur-xl border border-white/10 pointer-events-none">
    <div class="flex items-center gap-2 font-mono text-[10px] text-graphite uppercase tracking-widest mb-1">
      <span class="w-2 h-2 rounded-full bg-pure animate-ping"></span>
      <span>SIMULADOR DE LUZ 3D</span>
    </div>
    <h4 class="font-condensed text-xl font-bold uppercase text-pure">
      ESTUDIO CHIAROSCURO
    </h4>
    <p class="font-body text-xs text-silver/80 mt-1">
      Haz clic y arrastra para rotar la fuente de luz en el espacio tridimensional y observar cómo esculpe el volumen.
    </p>

    <div class="mt-4 pt-3 border-t border-white/10 font-mono text-[10px] text-graphite space-y-1">
      <div class="flex justify-between">
        <span>ÁNGULO AZIMUT:</span>
        <span id="light-azimuth" class="text-pure">45°</span>
      </div>
      <div class="flex justify-between">
        <span>ALTURA DE FOCO:</span>
        <span id="light-elevation" class="text-pure">30°</span>
      </div>
      <div class="flex justify-between">
        <span>ESTILO:</span>
        <span class="text-silver">Rembrandt / Split Light</span>
      </div>
    </div>
  </div>

  <!-- Interactive Preset Buttons -->
  <div class="absolute bottom-6 left-6 right-6 flex flex-wrap items-center justify-between gap-3 pointer-events-auto">
    <div class="flex items-center gap-2">
      <button class="light-preset-btn px-3 py-1.5 rounded bg-pure text-obsidian font-mono text-[10px] tracking-wider uppercase font-bold" data-preset="rembrandt" data-cursor="pointer">
        REMBRANDT
      </button>
      <button class="light-preset-btn px-3 py-1.5 rounded border border-white/10 hover:border-white/30 text-graphite hover:text-pure font-mono text-[10px] tracking-wider uppercase" data-preset="split" data-cursor="pointer">
        SPLIT LIGHT
      </button>
      <button class="light-preset-btn px-3 py-1.5 rounded border border-white/10 hover:border-white/30 text-graphite hover:text-pure font-mono text-[10px] tracking-wider uppercase" data-preset="butterfly" data-cursor="pointer">
        BUTTERFLY
      </button>
      <button class="light-preset-btn px-3 py-1.5 rounded border border-white/10 hover:border-white/30 text-graphite hover:text-pure font-mono text-[10px] tracking-wider uppercase" data-preset="rim" data-cursor="pointer">
        RIM LIGHT
      </button>
    </div>

    <div class="font-mono text-[10px] text-graphite uppercase hidden sm:block">
      THREE.JS PHYSICAL SHADOW ENGINE
    </div>
  </div>
</div>

<script>
  import * as THREE from 'three';

  const container = document.getElementById('light-sim-canvas');
  const azimuthElem = document.getElementById('light-azimuth');
  const elevationElem = document.getElementById('light-elevation');
  const presetBtns = document.querySelectorAll('.light-preset-btn');

  if (container) {
    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x0D0E11, 0.03);

    const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 100);
    camera.position.set(0, 0, 9);

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    container.appendChild(renderer.domElement);

    // Sculptural Monolith Geometry (Artistic Torus Knot + Base)
    const sculptGeometry = new THREE.TorusKnotGeometry(1.6, 0.55, 128, 32);
    const sculptMaterial = new THREE.MeshStandardMaterial({
      color: 0xEEEEEE,
      roughness: 0.35,
      metalness: 0.1,
    });
    const sculpture = new THREE.Mesh(sculptGeometry, sculptMaterial);
    sculpture.castShadow = true;
    sculpture.receiveShadow = true;
    sculpture.position.y = 0.2;
    scene.add(sculpture);

    // Studio Background Wall
    const wallGeometry = new THREE.PlaneGeometry(30, 20);
    const wallMaterial = new THREE.MeshStandardMaterial({
      color: 0x15161A,
      roughness: 0.9,
    });
    const wall = new THREE.Mesh(wallGeometry, wallMaterial);
    wall.position.z = -4;
    wall.receiveShadow = true;
    scene.add(wall);

    // Dynamic Key Spotlight
    const spotLight = new THREE.SpotLight(0xffffff, 80);
    spotLight.angle = Math.PI / 3;
    spotLight.penumbra = 0.8;
    spotLight.decay = 2;
    spotLight.distance = 25;
    spotLight.castShadow = true;
    spotLight.shadow.mapSize.width = 1024;
    spotLight.shadow.mapSize.height = 1024;
    spotLight.position.set(4, 4, 5);
    spotLight.target = sculpture;
    scene.add(spotLight);

    // Light Helper Sphere (The physical lamp in space)
    const lampGeo = new THREE.SphereGeometry(0.18, 16, 16);
    const lampMat = new THREE.MeshBasicMaterial({ color: 0xFFFFFF });
    const lampMesh = new THREE.Mesh(lampGeo, lampMat);
    lampMesh.position.copy(spotLight.position);
    scene.add(lampMesh);

    // Soft Ambient Fill Light (Low key)
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.08);
    scene.add(ambientLight);

    // Mouse Dragging to orbit light
    let isDragging = false;
    let previousX = 0;
    let previousY = 0;
    let lightAngleH = Math.PI / 4;
    let lightAngleV = Math.PI / 6;
    const lightRadius = 6.5;

    const updateLightPos = () => {
      spotLight.position.x = Math.sin(lightAngleH) * Math.cos(lightAngleV) * lightRadius;
      spotLight.position.y = Math.sin(lightAngleV) * lightRadius;
      spotLight.position.z = Math.cos(lightAngleH) * Math.cos(lightAngleV) * lightRadius;
      lampMesh.position.copy(spotLight.position);

      if (azimuthElem) azimuthElem.textContent = `${Math.round((lightAngleH * 180) / Math.PI)}°`;
      if (elevationElem) elevationElem.textContent = `${Math.round((lightAngleV * 180) / Math.PI)}°`;
    };

    updateLightPos();

    container.addEventListener('mousedown', (e) => {
      isDragging = true;
      previousX = e.clientX;
      previousY = e.clientY;
    });

    window.addEventListener('mouseup', () => { isDragging = false; });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const deltaX = e.clientX - previousX;
      const deltaY = e.clientY - previousY;
      previousX = e.clientX;
      previousY = e.clientY;

      lightAngleH += deltaX * 0.01;
      lightAngleV = Math.max(-Math.PI / 4, Math.min(Math.PI / 2.2, lightAngleV - deltaY * 0.01));
      updateLightPos();
    });

    // Touch support
    container.addEventListener('touchmove', (e) => {
      if (e.touches.length !== 1) return;
      const touch = e.touches[0];
      if (previousX === 0) {
        previousX = touch.clientX;
        previousY = touch.clientY;
        return;
      }
      const deltaX = touch.clientX - previousX;
      const deltaY = touch.clientY - previousY;
      previousX = touch.clientX;
      previousY = touch.clientY;

      lightAngleH += deltaX * 0.012;
      lightAngleV = Math.max(-Math.PI / 4, Math.min(Math.PI / 2.2, lightAngleV - deltaY * 0.012));
      updateLightPos();
    });

    container.addEventListener('touchend', () => { previousX = 0; });

    // Presets
    const presets = {
      rembrandt: { h: Math.PI / 4, v: Math.PI / 5 },
      split: { h: Math.PI / 2, v: 0.05 },
      butterfly: { h: 0, v: Math.PI / 2.8 },
      rim: { h: Math.PI * 0.85, v: Math.PI / 8 },
    };

    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        presetBtns.forEach(b => {
          b.classList.remove('bg-pure', 'text-obsidian', 'font-bold');
          b.classList.add('text-graphite', 'border-white/10');
        });
        btn.classList.add('bg-pure', 'text-obsidian', 'font-bold');
        btn.classList.remove('text-graphite', 'border-white/10');

        const key = btn.getAttribute('data-preset') as keyof typeof presets;
        if (presets[key]) {
          lightAngleH = presets[key].h;
          lightAngleV = presets[key].v;
          updateLightPos();
        }
      });
    });

    // Animation loop
    const animate = () => {
      requestAnimationFrame(animate);
      sculpture.rotation.y += 0.003;
      renderer.render(scene, camera);
    };

    animate();

    window.addEventListener('resize', () => {
      if (!container) return;
      camera.aspect = container.clientWidth / container.clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(container.clientWidth, container.clientHeight);
    });
  }
</script>
