---
import { CREATOR } from '../../data/creator';
---

<footer class="w-full bg-carbon/50 border-t border-white/10 text-pure py-16">
  <div class="w-full px-6 md:px-12">
    
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-white/10">
      
      <!-- Brand Statement -->
      <div class="md:col-span-2 space-y-3">
        <span class="font-condensed text-3xl font-bold tracking-[0.2em] text-pure block">
          MOMMENTUM
        </span>
        <p class="font-body text-xs text-silver/80 max-w-md leading-relaxed">
          Galería personal de fotografía. Registro visual de momentos cotidianos, viajes, paisajes y retratos.
        </p>
      </div>

      <!-- Quick Navigation -->
      <div class="space-y-2 font-mono text-xs text-silver/80">
        <span class="font-bold text-white uppercase block mb-3">// ESPACIOS</span>
        <a href="/" class="block hover:text-white transition-colors" data-cursor="pointer">Inicio</a>
        <a href="/quien-soy" class="block hover:text-white transition-colors" data-cursor="pointer">Quién Soy</a>
        <a href="/portafolio" class="block hover:text-white transition-colors" data-cursor="pointer">Portafolio</a>
        <a href="/museo" class="block hover:text-white transition-colors" data-cursor="pointer">Museo Virtual</a>
        <a href="/creativo" class="block hover:text-white transition-colors" data-cursor="pointer">Mesa Creativa</a>
        <a href="/mural" class="block hover:text-white transition-colors" data-cursor="pointer">Mural Espacial</a>
        <a href="/fotografos" class="block hover:text-white transition-colors" data-cursor="pointer">Fotógrafos</a>
      </div>

      <!-- Creator Details -->
      <div class="space-y-2 font-mono text-xs text-silver/80">
        <span class="font-bold text-white uppercase block mb-3">// CONTACTO & REDES</span>
        <p class="text-white font-bold">{CREATOR.name}</p>
        <a href={`mailto:${CREATOR.email}`} class="block text-white hover:underline transition-all" data-cursor="pointer">
          {CREATOR.email}
        </a>
        <a href={CREATOR.instagram} target="_blank" rel="noopener noreferrer" class="block text-white hover:underline transition-all pt-2 font-bold" data-cursor="pointer">
          Instagram @mommentum.ises ↗
        </a>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between font-mono text-[10px] text-graphite gap-4">
      <span>© 2026 MOMMENTUM. TODOS LOS DERECHOS RESERVADOS.</span>
      <span>FOTOGRAFÍA & MOMENTOS</span>
    </div>

  </div>
</footer>
