---
const currentPath = Astro.url.pathname;

const navLinks = [
  { name: 'INICIO', href: '/', num: '01' },
  { name: 'QUIÉN SOY', href: '/quien-soy', num: '02' },
  { name: 'ÁLBUMES', href: '/portafolio', num: '03' },
  { name: 'MUSEO', href: '/museo', num: '04' },
  { name: 'CREATIVO', href: '/creativo', num: '05' },
  { name: 'MURAL', href: '/mural', num: '06' },
  { name: 'FOTÓGRAFOS', href: '/fotografos', num: '07' },
];
---

<!-- Universal Sticky Header -->
<header class="fixed top-0 left-0 w-full z-40 bg-[#07080B] border-b border-white/10 transition-all duration-300">
  <div class="w-full px-5 sm:px-8 md:px-12 h-20 flex items-center justify-between">
    
    <!-- Clean Typography Brand -->
    <a href="/" class="flex items-center gap-2 sm:gap-3 group" data-cursor="pointer">
      <span class="font-condensed text-2xl sm:text-3xl font-bold tracking-[0.18em] text-white group-hover:text-silver transition-colors">
        MOMMENTUM
      </span>
      <span class="font-mono text-[9px] text-graphite tracking-widest hidden md:inline-block uppercase border-l border-white/20 pl-3">
        FOTOGRAFÍAS
      </span>
    </a>

    <!-- Desktop Navigation Links (Visible on lg screens) -->
    <nav class="hidden lg:flex items-center gap-8 font-mono text-xs tracking-wider">
      {navLinks.map((link) => (
        <a 
          href={link.href} 
          class={`transition-colors py-1 ${
            (currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)))
              ? 'text-white font-bold border-b border-white' 
              : 'text-silver/70 hover:text-white'
          }`}
          data-cursor="pointer"
        >
          {link.name}
        </a>
      ))}
    </nav>

    <!-- Right Controls: Replay + Instagram + Mobile Hamburger Button -->
    <div class="flex items-center gap-2.5 sm:gap-4">
      <a 
        href="/?replay=1" 
        class="w-9 h-9 rounded border border-white/20 hover:border-white flex items-center justify-center text-white/80 hover:text-white hover:bg-white/5 transition-all text-sm" 
        title="Ver Intro"
        data-cursor="pointer"
      >
        ↺
      </a>

      <a 
        href="https://www.instagram.com/mommentum.ises/" 
        target="_blank" 
        rel="noopener noreferrer"
        class="hidden sm:inline-block px-4 py-2 border border-white/20 hover:border-white rounded font-mono text-xs text-white hover:bg-white hover:text-obsidian transition-all uppercase tracking-wider"
        data-cursor="pointer"
      >
        @mommentum.ises ↗
      </a>

      <!-- Prominent Mobile Hamburger Menu Button -->
      <button 
        id="mobile-menu-btn" 
        onclick="window.toggleMobileDrawer && window.toggleMobileDrawer(true)"
        class="lg:hidden relative z-40 w-11 h-11 rounded-lg bg-[#14161F] border border-white/30 hover:border-white flex flex-col items-center justify-center gap-1.5 p-2 text-white transition-all shadow-xl active:scale-95"
        aria-label="Abrir Menú"
        data-cursor="pointer"
      >
        <span class="w-5 h-0.5 bg-white rounded-full"></span>
        <span class="w-5 h-0.5 bg-white rounded-full"></span>
        <span class="w-5 h-0.5 bg-white rounded-full"></span>
      </button>
    </div>

  </div>
</header>

<!-- 100% Solid Opaque Fullscreen Mobile Navigation Drawer (Absolute Top Layer z-[9999999]) -->
<div 
  id="mobile-menu-drawer" 
  style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; width: 100vw; height: 100vh; height: 100dvh; background-color: #07080B !important; z-index: 9999999; overflow-y: auto;"
  class="flex-col justify-between p-6 sm:p-10 select-none"
>
  <!-- Drawer Top Bar -->
  <div class="flex items-center justify-between border-b border-white/15 pb-5 w-full">
    <a href="/" onclick="window.toggleMobileDrawer && window.toggleMobileDrawer(false)" class="flex items-center gap-2">
      <span class="font-condensed text-2xl font-bold tracking-[0.18em] text-white">
        MOMMENTUM
      </span>
      <span class="font-mono text-[9px] text-graphite tracking-widest uppercase border-l border-white/20 pl-2">
        MENÚ
      </span>
    </a>

    <!-- Big Dedicated Close Button (✕ CERRAR) -->
    <button 
      id="mobile-drawer-close-btn" 
      onclick="window.toggleMobileDrawer && window.toggleMobileDrawer(false)"
      class="px-4 py-2 rounded-full border border-white/30 hover:border-white flex items-center gap-2 text-white bg-[#14161F] text-xs font-mono font-bold active:scale-90 transition-transform shadow-lg"
      aria-label="Cerrar Menú"
    >
      <span>✕</span> <span>CERRAR</span>
    </button>
  </div>

  <!-- Drawer Links List -->
  <nav class="flex flex-col py-6 space-y-2 w-full my-auto">
    {navLinks.map((link) => {
      const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
      return (
        <a 
          href={link.href} 
          onclick="window.toggleMobileDrawer && window.toggleMobileDrawer(false)"
          class={`mobile-nav-link group flex items-center justify-between py-3.5 px-4 rounded-xl transition-all duration-200 ${
            isActive 
              ? 'bg-white/15 text-white font-bold border border-white/30' 
              : 'text-silver/80 hover:text-white hover:bg-white/5 border border-transparent'
          }`}
        >
          <div class="flex items-center gap-3.5">
            <span class="font-mono text-[11px] text-graphite group-hover:text-silver transition-colors">
              // {link.num}
            </span>
            <span class="font-condensed text-2xl sm:text-3xl uppercase tracking-wider text-white">
              {link.name}
            </span>
          </div>
          <span class="font-mono text-xs text-graphite group-hover:text-white transition-colors">
            {isActive ? '● ACTIVO' : '→'}
          </span>
        </a>
      );
    })}
  </nav>

  <!-- Drawer Bottom Footer -->
  <div class="border-t border-white/15 pt-5 flex flex-col gap-3 font-mono text-xs text-graphite w-full">
    <a 
      href="https://www.instagram.com/mommentum.ises/" 
      target="_blank" 
      rel="noopener noreferrer"
      class="w-full py-3.5 bg-white hover:bg-silver text-[#07080B] font-bold text-center rounded-xl uppercase tracking-wider text-xs shadow-xl transition-colors block"
    >
      INSTAGRAM @MOMMENTUM.ISES ↗
    </a>
    <div class="flex items-center justify-between text-[10px] text-silver/60 pt-1">
      <span>VICTOR CIFUENTES</span>
      <a 
        href="https://promptendweb.com/" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-silver hover:text-white underline underline-offset-2 flex items-center gap-1"
      >
        <span>PROMPTEND</span>
        <span>↗</span>
      </a>
    </div>
  </div>

</div>

<!-- Inline Bulletproof Script to ensure 100% immediate responsiveness -->
<script is:inline>
  window.toggleMobileDrawer = function(open) {
    var drawer = document.getElementById('mobile-menu-drawer');
    if (!drawer) return;
    if (open) {
      drawer.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    } else {
      drawer.style.display = 'none';
      document.body.style.overflow = 'auto';
    }
  };

  document.addEventListener('DOMContentLoaded', function() {
    var btnOpen = document.getElementById('mobile-menu-btn');
    var btnClose = document.getElementById('mobile-drawer-close-btn');
    if (btnOpen) {
      btnOpen.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        window.toggleMobileDrawer(true);
      });
    }
    if (btnClose) {
      btnClose.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        window.toggleMobileDrawer(false);
      });
    }
  });
</script>
