---
// Monochromatic Architectural Multi-Page Footer Component
---

<footer class="relative w-full bg-obsidian text-pure border-t border-white/10 pt-20 pb-12 px-6 md:px-12 overflow-hidden">
  <div class="max-w-7xl mx-auto flex flex-col justify-between">
    
    <!-- Top Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 pb-16 border-b border-white/10">
      
      <!-- Brand column -->
      <div class="md:col-span-5 flex flex-col justify-between">
        <div>
          <a href="/" class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 rounded bg-pure flex items-center justify-center text-obsidian font-condensed font-bold text-lg">
              M
            </div>
            <span class="font-condensed text-2xl font-bold tracking-[0.2em] text-pure">MOMMENTUM</span>
          </a>
          <p class="font-body text-xs md:text-sm text-silver/80 max-w-sm leading-relaxed">
            Estudio de fotografía conceptual y de autor. Congelar la energía, el impulso y la autenticidad en una fracción de segundo.
          </p>
        </div>

        <div class="mt-8 font-mono text-[10px] text-graphite space-y-1">
          <p>HORA LOCAL DEL ESTUDIO: <span id="studio-clock" class="text-silver">--:--:-- CST</span></p>
          <p>COORDENADAS: 19.4326° N, 99.1332° W • CDMX</p>
        </div>
      </div>

      <!-- Multi-Page Links -->
      <div class="md:col-span-3 font-mono text-xs text-graphite space-y-3">
        <span class="text-[10px] tracking-widest text-pure uppercase block mb-4">// SALAS & PORTAFOLIO</span>
        <a href="/" class="block hover:text-pure transition-colors" data-cursor="pointer">01/ Sala Principal</a>
        <a href="/colecciones" class="block hover:text-pure transition-colors" data-cursor="pointer">02/ Colecciones 3D</a>
        <a href="/obras" class="block hover:text-pure transition-colors" data-cursor="pointer">03/ Catálogo de Obras</a>
        <a href="/manifiesto" class="block hover:text-pure transition-colors" data-cursor="pointer">04/ Manifiesto & Luz 3D</a>
        <a href="/laboratorio" class="block hover:text-pure transition-colors" data-cursor="pointer">05/ Laboratorio & Diario</a>
        <a href="/adquisiciones" class="block hover:text-pure transition-colors" data-cursor="pointer">06/ Adquisición & Booking</a>
      </div>

      <!-- Social & Connect -->
      <div class="md:col-span-4 font-mono text-xs text-graphite space-y-3">
        <span class="text-[10px] tracking-widest text-pure uppercase block mb-4">// CONTACTO DE GALERÍA</span>
        <a href="https://www.instagram.com/mommentum.ises/" target="_blank" rel="noopener noreferrer" class="block hover:text-pure transition-colors flex items-center justify-between" data-cursor="pointer">
          <span>Instagram (@mommentum.ises)</span>
          <span>↗</span>
        </a>
        <a href="https://www.threads.net/@mommentum.ises" target="_blank" rel="noopener noreferrer" class="block hover:text-pure transition-colors flex items-center justify-between" data-cursor="pointer">
          <span>Threads</span>
          <span>↗</span>
        </a>
        <a href="mailto:contacto@mommentum.ises" class="block hover:text-pure transition-colors flex items-center justify-between" data-cursor="pointer">
          <span>contacto@mommentum.ises</span>
          <span>↗</span>
        </a>
      </div>
    </div>

    <!-- Massive Wordmark Background -->
    <div class="py-12 select-none overflow-hidden text-center opacity-10 hover:opacity-20 transition-opacity duration-700">
      <span class="font-condensed font-bold text-[18vw] leading-none tracking-tighter text-pure block">
        MOMMENTUM
      </span>
    </div>

    <!-- Bottom Credits & Back to Top -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-[10px] text-graphite tracking-widest uppercase pt-6">
      <div>
        <p>© 2026 MOMMENTUM STUDIO. TODOS LOS DERECHOS RESERVADOS.</p>
      </div>

      <button id="back-to-top" class="hover:text-pure transition-colors flex items-center gap-2" data-cursor="pointer">
        <span>VOLVER AL INICIO</span>
        <span>↑</span>
      </button>
    </div>
  </div>
</footer>

<script>
  // Live Studio Clock
  const clock = document.getElementById('studio-clock');
  const updateClock = () => {
    if (!clock) return;
    const now = new Date();
    const timeStr = now.toLocaleTimeString('es-MX', { timeZone: 'America/Mexico_City', hour12: false });
    clock.textContent = `${timeStr} CST`;
  };
  setInterval(updateClock, 1000);
  updateClock();

  // Back to top smooth scroll
  const backToTop = document.getElementById('back-to-top');
  if (backToTop) {
    backToTop.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
