---
// Split-Curtain Page Transition: Theatrical Dual-Panel Reveal (Cinematic, Visible & Zero Flicker)
---

<div id="curtain-transition-container" class="fixed inset-0 z-[9999999] pointer-events-none select-none flex overflow-hidden hidden" style="will-change: transform;">
  
  <!-- Left Curtain Panel -->
  <div 
    id="curtain-left" 
    class="w-1/2 h-full bg-[#07080B] border-r border-white/20 flex items-center justify-end pr-4 shadow-[10px_0_30px_rgba(0,0,0,0.8)]"
    style="transform: translate3d(-100%, 0, 0); will-change: transform;"
  >
    <div class="w-1 h-20 rounded-full bg-white/25"></div>
  </div>

  <!-- Right Curtain Panel -->
  <div 
    id="curtain-right" 
    class="w-1/2 h-full bg-[#07080B] border-l border-white/20 flex items-center justify-start pl-4 shadow-[-10px_0_30px_rgba(0,0,0,0.8)]"
    style="transform: translate3d(100%, 0, 0); will-change: transform;"
  >
    <div class="w-1 h-20 rounded-full bg-white/25"></div>
  </div>

  <!-- Center Monogram Watermark -->
  <div 
    id="curtain-center-badge" 
    class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none opacity-0 flex flex-col items-center z-20"
    style="will-change: transform, opacity;"
  >
    <div class="w-12 h-12 rounded-full border border-white/20 bg-[#14161F]/80 backdrop-blur-md flex items-center justify-center mb-3">
      <span class="font-condensed text-xl font-bold text-white tracking-widest">M</span>
    </div>
    <span class="font-condensed text-3xl sm:text-4xl font-bold tracking-[0.25em] text-white uppercase drop-shadow-[0_0_20px_rgba(255,255,255,0.3)]">
      MOMMENTUM
    </span>
    <span class="font-mono text-[10px] text-graphite tracking-[0.3em] uppercase mt-1.5 font-bold">
      FOTOGRAFÍAS & MOMENTOS
    </span>
  </div>

</div>

<script>
  import gsap from 'gsap';

  const container = document.getElementById('curtain-transition-container');
  const curtainLeft = document.getElementById('curtain-left');
  const curtainRight = document.getElementById('curtain-right');
  const centerBadge = document.getElementById('curtain-center-badge');

  const isNavigating = sessionStorage.getItem('mommentum_navigating') === 'true';

  if (isNavigating && container && curtainLeft && curtainRight) {
    sessionStorage.removeItem('mommentum_navigating');

    container.classList.remove('hidden');
    container.style.display = 'flex';
    document.documentElement.classList.remove('curtain-covering');

    // Start with curtains fully closed and badge visible
    gsap.set(curtainLeft, { xPercent: 0 });
    gsap.set(curtainRight, { xPercent: 0 });
    if (centerBadge) gsap.set(centerBadge, { opacity: 1, scale: 1 });

    // Theatrical Opening Sequence
    const tl = gsap.timeline({
      delay: 0.12,
      onComplete: () => {
        if (container) {
          container.classList.add('hidden');
          container.style.display = 'none';
        }
      }
    });

    if (centerBadge) {
      tl.to(centerBadge, { 
        opacity: 0, 
        scale: 0.88, 
        duration: 0.3, 
        ease: 'power2.in' 
      }, 0);
    }

    tl.to(curtainLeft, {
      xPercent: -100,
      duration: 0.6,
      ease: 'power3.inOut'
    }, 0.1)
    .to(curtainRight, {
      xPercent: 100,
      duration: 0.6,
      ease: 'power3.inOut'
    }, 0.1);

  } else {
    document.documentElement.classList.remove('curtain-covering');
    if (container) {
      container.classList.add('hidden');
      container.style.display = 'none';
    }
  }

  // Theatrical Closing Sequence
  const closeCurtainsAndNavigate = (href: string) => {
    if (!container || !curtainLeft || !curtainRight) {
      window.location.href = href;
      return;
    }

    sessionStorage.setItem('mommentum_navigating', 'true');
    container.classList.remove('hidden');
    container.style.display = 'flex';
    container.style.pointerEvents = 'auto';

    gsap.killTweensOf([curtainLeft, curtainRight, centerBadge]);

    const tl = gsap.timeline({
      onComplete: () => {
        window.location.href = href;
      }
    });

    tl.fromTo(curtainLeft, { xPercent: -100 }, {
      xPercent: 0,
      duration: 0.5,
      ease: 'power3.inOut'
    }, 0)
    .fromTo(curtainRight, { xPercent: 100 }, {
      xPercent: 0,
      duration: 0.5,
      ease: 'power3.inOut'
    }, 0);

    if (centerBadge) {
      tl.fromTo(centerBadge, { 
        opacity: 0, 
        scale: 0.85 
      }, { 
        opacity: 1, 
        scale: 1, 
        duration: 0.35, 
        ease: 'power2.out' 
      }, 0.15);
    }
  };

  // Intercept all internal navigation links
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('a');
    if (!target) return;

    const href = target.getAttribute('href');
    if (!href) return;

    if (
      href.startsWith('/') && 
      !href.startsWith('#') && 
      !href.includes('replay=') && 
      !target.getAttribute('target') &&
      href !== window.location.pathname
    ) {
      e.preventDefault();
      closeCurtainsAndNavigate(href);
    }
  });
</script>
