---
// Custom Photographic Lens Reticle Cursor
---

<div id="custom-cursor" class="fixed top-0 left-0 w-8 h-8 pointer-events-none z-[99999] mix-blend-difference hidden md:flex items-center justify-center -translate-x-1/2 -translate-y-1/2 transition-transform duration-75">
  <div id="cursor-dot" class="w-1.5 h-1.5 bg-white rounded-full transition-all duration-300"></div>
  <div id="cursor-ring" class="absolute w-8 h-8 border border-white/50 rounded-full transition-all duration-300"></div>
  
  <!-- Optical Crosshair Marks -->
  <div id="cross-top" class="absolute -top-1 w-[1px] h-2 bg-white/60"></div>
  <div id="cross-bottom" class="absolute -bottom-1 w-[1px] h-2 bg-white/60"></div>
  <div id="cross-left" class="absolute -left-1 h-[1px] w-2 bg-white/60"></div>
  <div id="cross-right" class="absolute -right-1 h-[1px] w-2 bg-white/60"></div>

  <span id="cursor-label" class="absolute font-mono text-[9px] uppercase text-black font-bold opacity-0 transition-opacity duration-200"></span>
</div>

<script>
  import gsap from 'gsap';

  const cursor = document.getElementById('custom-cursor');
  const dot = document.getElementById('cursor-dot');
  const ring = document.getElementById('cursor-ring');
  const label = document.getElementById('cursor-label');

  if (cursor && dot && ring && label && window.matchMedia('(pointer: fine)').matches) {
    let mouseX = window.innerWidth / 2;
    let mouseY = window.innerHeight / 2;
    let cursorX = mouseX;
    let cursorY = mouseY;

    window.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
    });

    gsap.ticker.add(() => {
      cursorX += (mouseX - cursorX) * 0.25;
      cursorY += (mouseY - cursorY) * 0.25;
      cursor.style.transform = `translate3d(${cursorX}px, ${cursorY}px, 0)`;
    });

    const attachHoverEvents = () => {
      document.querySelectorAll('a, button, [data-cursor]').forEach((el) => {
        el.addEventListener('mouseenter', () => {
          const type = el.getAttribute('data-cursor') || 'pointer';
          
          if (type === 'view') {
            gsap.to(dot, { scale: 0, duration: 0.2 });
            gsap.to(ring, { width: 68, height: 68, backgroundColor: '#FFFFFF', borderColor: '#FFFFFF', duration: 0.25 });
            label.textContent = 'VER';
            label.style.opacity = '1';
          } else if (type === 'drag') {
            gsap.to(dot, { scale: 0, duration: 0.2 });
            gsap.to(ring, { width: 78, height: 78, backgroundColor: '#FFFFFF', borderColor: '#FFFFFF', duration: 0.25 });
            label.textContent = 'GIRAR';
            label.style.opacity = '1';
          } else if (type === 'explore') {
            gsap.to(dot, { scale: 0, duration: 0.2 });
            gsap.to(ring, { width: 78, height: 78, backgroundColor: '#FFFFFF', borderColor: '#FFFFFF', duration: 0.25 });
            label.textContent = 'EXPLORAR';
            label.style.opacity = '1';
          } else {
            gsap.to(ring, { width: 42, height: 42, borderColor: '#FFFFFF', duration: 0.2 });
            gsap.to(dot, { scale: 1.4, duration: 0.2 });
            label.style.opacity = '0';
          }
        });

        el.addEventListener('mouseleave', () => {
          gsap.to(ring, { width: 32, height: 32, backgroundColor: 'transparent', borderColor: 'rgba(255,255,255,0.5)', duration: 0.2 });
          gsap.to(dot, { scale: 1, duration: 0.2 });
          label.style.opacity = '0';
        });
      });
    };

    attachHoverEvents();
    document.addEventListener('astro:page-load', attachHoverEvents);
  }
</script>
