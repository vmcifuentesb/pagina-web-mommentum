---
// Universal Transition Studio: 5 Distinct High-End Transitions (100% Reliable, Zero Freeze)
---

<!-- Transition Container Overlays -->
<div id="transition-studio-overlay" class="fixed inset-0 z-[9999999] pointer-events-none select-none overflow-hidden hidden bg-[#07080B]" style="will-change: transform, opacity;" transition:persist>

  <!-- Style 1: Dual Horizontal Split Curtain (INICIO) -->
  <div id="fx-curtain" class="absolute inset-0 flex transition-fx hidden">
    <div id="fx-curtain-l" class="w-1/2 h-full bg-[#07080B] border-r border-white/20 flex items-center justify-end pr-4" style="will-change: transform;">
      <div class="w-1 h-20 rounded-full bg-white/30"></div>
    </div>
    <div id="fx-curtain-r" class="w-1/2 h-full bg-[#07080B] border-l border-white/20 flex items-center justify-start pl-4" style="will-change: transform;">
      <div class="w-1 h-20 rounded-full bg-white/30"></div>
    </div>
    <div id="fx-curtain-badge" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 flex flex-col items-center opacity-0 z-20" style="will-change: transform, opacity;">
      <div class="w-12 h-12 rounded-full border border-white/30 bg-[#14161F] flex items-center justify-center mb-2">
        <span class="font-condensed text-xl font-bold text-white">M</span>
      </div>
      <span class="font-condensed text-3xl sm:text-4xl font-bold tracking-[0.25em] text-white uppercase">MOMMENTUM</span>
      <span class="font-mono text-[9px] text-graphite tracking-widest uppercase mt-1">CORTINA DUAL</span>
    </div>
  </div>

  <!-- Style 2: Camera Iris / Diafragma de Obturador (MUSEO 3D) -->
  <div id="fx-iris" class="absolute inset-0 bg-[#07080B] transition-fx hidden flex items-center justify-center" style="clip-path: circle(0% at 50% 50%); will-change: clip-path;">
    <div id="fx-iris-content" class="flex flex-col items-center text-center opacity-0 z-20" style="will-change: transform, opacity;">
      <div class="w-16 h-16 rounded-full border-2 border-white/40 flex items-center justify-center mb-3">
        <div class="w-8 h-8 rounded-full border border-white/60"></div>
      </div>
      <span class="font-condensed text-3xl sm:text-5xl font-bold tracking-[0.3em] text-white uppercase">MOMMENTUM</span>
      <span class="font-mono text-[10px] text-silver tracking-[0.25em] uppercase mt-1.5">// DIAFRAGMA ÓPTICO f/1.4</span>
    </div>
  </div>

  <!-- Style 3: Vertical Curtain / Telón Cinemático (FOTÓGRAFOS) -->
  <div id="fx-vertical" class="absolute inset-0 transition-fx hidden flex flex-col">
    <div id="fx-vert-top" class="w-full h-1/2 bg-[#07080B] border-b border-white/20 flex items-end justify-center pb-4" style="will-change: transform;">
      <div class="w-24 h-1 rounded-full bg-white/30"></div>
    </div>
    <div id="fx-vert-bot" class="w-full h-1/2 bg-[#07080B] border-t border-white/20 flex items-start justify-center pt-4" style="will-change: transform;">
      <div class="w-24 h-1 rounded-full bg-white/30"></div>
    </div>
    <div id="fx-vert-badge" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 flex flex-col items-center opacity-0 z-20" style="will-change: transform, opacity;">
      <span class="font-condensed text-3xl sm:text-4xl font-bold tracking-[0.25em] text-white uppercase">MOMMENTUM</span>
      <span class="font-mono text-[10px] text-graphite tracking-widest uppercase mt-1">// TELÓN CINEMÁTICO</span>
    </div>
  </div>

  <!-- Style 4: Staggered Multi-Columns (PORTAFOLIO) -->
  <div id="fx-columns" class="absolute inset-0 transition-fx hidden flex">
    <div class="fx-col flex-1 h-full bg-[#07080B] border-r border-white/10" style="will-change: transform;"></div>
    <div class="fx-col flex-1 h-full bg-[#0A0B10] border-r border-white/10" style="will-change: transform;"></div>
    <div class="fx-col flex-1 h-full bg-[#07080B] border-r border-white/10" style="will-change: transform;"></div>
    <div class="fx-col flex-1 h-full bg-[#0A0B10] border-r border-white/10" style="will-change: transform;"></div>
    <div class="fx-col flex-1 h-full bg-[#07080B]" style="will-change: transform;"></div>
    <div id="fx-col-badge" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 flex flex-col items-center opacity-0 z-20" style="will-change: transform, opacity;">
      <span class="font-condensed text-3xl sm:text-4xl font-bold tracking-[0.25em] text-white uppercase">MOMMENTUM</span>
      <span class="font-mono text-[10px] text-graphite tracking-widest uppercase mt-1">// COLUMNAS ESCALONADAS</span>
    </div>
  </div>

  <!-- Style 5: Camera Flash & Exposure Fade (QUIÉN SOY) -->
  <div id="fx-flash" class="absolute inset-0 bg-[#07080B] transition-fx hidden flex items-center justify-center opacity-0" style="will-change: opacity;">
    <div id="fx-flash-burst" class="absolute inset-0 bg-white opacity-0 pointer-events-none" style="will-change: opacity;"></div>
    <div id="fx-flash-content" class="flex flex-col items-center text-center opacity-0 z-20" style="will-change: transform, opacity;">
      <span class="font-mono text-[10px] text-graphite tracking-[0.3em] uppercase mb-2">✦ BIOGRAFÍA & CREACIÓN</span>
      <span class="font-condensed text-3xl sm:text-4xl font-bold tracking-[0.25em] text-white uppercase">VICTOR CIFUENTES</span>
    </div>
  </div>

</div>

<script>
  import gsap from 'gsap';

  // Ensure persistent state on window that survives Astro DOM swaps
  const globalNav = (window as any).__mommentumNav || { isNavigating: false, style: 'curtain' };
  (window as any).__mommentumNav = globalNav;

  const overlay = document.getElementById('transition-studio-overlay');

  const getTransitionForPath = (path: string): string => {
    const p = path.toLowerCase();
    if (p.includes('/museo')) return 'iris';
    if (p.includes('/fotografos')) return 'vertical';
    if (p === '/portafolio' || p === '/portafolio/') return 'columns';
    if (p.includes('/quien-soy')) return 'flash';
    if (p.includes('/creativo')) return 'vertical';
    if (p.includes('/mural')) return 'columns';
    if (p.includes('/portafolio/ruby')) return 'flash';
    if (p.includes('/portafolio/sesion-andy')) return 'iris';
    if (p.includes('/portafolio/antigua-guatemala')) return 'curtain';
    if (p.includes('/portafolio/caravana-del-zorro')) return 'columns';
    if (p.includes('/portafolio/familia-erick')) return 'vertical';
    if (p.includes('/portafolio/semana-santa')) return 'curtain';
    if (p.includes('/portafolio/sesion-embarazada')) return 'iris';
    return 'curtain';
  };

  const hideAllFx = () => {
    document.querySelectorAll('.transition-fx').forEach(el => {
      (el as HTMLElement).classList.add('hidden');
      (el as HTMLElement).style.display = 'none';
      gsap.killTweensOf(el);
    });
  };

  // 1. Dual Curtain
  const runCurtainIn = (onComplete: () => void) => {
    const el = document.getElementById('fx-curtain');
    const cl = document.getElementById('fx-curtain-l');
    const cr = document.getElementById('fx-curtain-r');
    const badge = document.getElementById('fx-curtain-badge');
    if (!el || !cl || !cr) return onComplete();

    hideAllFx();
    el.classList.remove('hidden');
    el.style.display = 'flex';

    gsap.killTweensOf([cl, cr, badge]);
    gsap.timeline({ onComplete })
      .fromTo(cl, { xPercent: -100 }, { xPercent: 0, duration: 0.3, ease: 'power2.inOut' }, 0)
      .fromTo(cr, { xPercent: 100 }, { xPercent: 0, duration: 0.3, ease: 'power2.inOut' }, 0)
      .fromTo(badge, { opacity: 0, scale: 0.9 }, { opacity: 1, scale: 1, duration: 0.2, ease: 'power2.out' }, 0.1);
  };

  const runCurtainOut = (onComplete: () => void) => {
    const el = document.getElementById('fx-curtain');
    const cl = document.getElementById('fx-curtain-l');
    const cr = document.getElementById('fx-curtain-r');
    const badge = document.getElementById('fx-curtain-badge');
    if (!el || !cl || !cr) return onComplete();

    hideAllFx();
    el.classList.remove('hidden');
    el.style.display = 'flex';
    gsap.killTweensOf([cl, cr, badge]);
    gsap.set(cl, { xPercent: 0 });
    gsap.set(cr, { xPercent: 0 });
    if (badge) gsap.set(badge, { opacity: 1, scale: 1 });

    gsap.timeline({ onComplete })
      .to(badge, { opacity: 0, scale: 0.95, duration: 0.15, ease: 'power2.in' }, 0)
      .to(cl, { xPercent: -100, duration: 0.35, ease: 'power2.inOut' }, 0.05)
      .to(cr, { xPercent: 100, duration: 0.35, ease: 'power2.inOut' }, 0.05);
  };

  // 2. Camera Iris
  const runIrisIn = (onComplete: () => void) => {
    const el = document.getElementById('fx-iris');
    const content = document.getElementById('fx-iris-content');
    if (!el) return onComplete();

    hideAllFx();
    el.classList.remove('hidden');
    el.style.display = 'flex';

    gsap.killTweensOf([el, content]);
    gsap.timeline({ onComplete })
      .fromTo(el, { clipPath: 'circle(0% at 50% 50%)' }, { clipPath: 'circle(150% at 50% 50%)', duration: 0.32, ease: 'power2.inOut' }, 0)
      .fromTo(content, { opacity: 0, scale: 0.85 }, { opacity: 1, scale: 1, duration: 0.2, ease: 'power2.out' }, 0.12);
  };

  const runIrisOut = (onComplete: () => void) => {
    const el = document.getElementById('fx-iris');
    const content = document.getElementById('fx-iris-content');
    if (!el) return onComplete();

    hideAllFx();
    el.classList.remove('hidden');
    el.style.display = 'flex';
    gsap.killTweensOf([el, content]);
    gsap.set(el, { clipPath: 'circle(150% at 50% 50%)' });
    if (content) gsap.set(content, { opacity: 1, scale: 1 });

    gsap.timeline({ onComplete })
      .to(content, { opacity: 0, scale: 1.05, duration: 0.14, ease: 'power2.in' }, 0)
      .to(el, { clipPath: 'circle(0% at 50% 50%)', duration: 0.35, ease: 'power2.inOut' }, 0.05);
  };

  // 3. Vertical Curtain
  const runVerticalIn = (onComplete: () => void) => {
    const el = document.getElementById('fx-vertical');
    const vt = document.getElementById('fx-vert-top');
    const vb = document.getElementById('fx-vert-bot');
    const badge = document.getElementById('fx-vert-badge');
    if (!el || !vt || !vb) return onComplete();

    hideAllFx();
    el.classList.remove('hidden');
    el.style.display = 'flex';

    gsap.killTweensOf([vt, vb, badge]);
    gsap.timeline({ onComplete })
      .fromTo(vt, { yPercent: -100 }, { yPercent: 0, duration: 0.3, ease: 'power2.inOut' }, 0)
      .fromTo(vb, { yPercent: 100 }, { yPercent: 0, duration: 0.3, ease: 'power2.inOut' }, 0)
      .fromTo(badge, { opacity: 0, scale: 0.9 }, { opacity: 1, scale: 1, duration: 0.2, ease: 'power2.out' }, 0.1);
  };

  const runVerticalOut = (onComplete: () => void) => {
    const el = document.getElementById('fx-vertical');
    const vt = document.getElementById('fx-vert-top');
    const vb = document.getElementById('fx-vert-bot');
    const badge = document.getElementById('fx-vert-badge');
    if (!el || !vt || !vb) return onComplete();

    hideAllFx();
    el.classList.remove('hidden');
    el.style.display = 'flex';
    gsap.killTweensOf([vt, vb, badge]);
    gsap.set(vt, { yPercent: 0 });
    gsap.set(vb, { yPercent: 0 });
    if (badge) gsap.set(badge, { opacity: 1, scale: 1 });

    gsap.timeline({ onComplete })
      .to(badge, { opacity: 0, scale: 0.95, duration: 0.15, ease: 'power2.in' }, 0)
      .to(vt, { yPercent: -100, duration: 0.35, ease: 'power2.inOut' }, 0.05)
      .to(vb, { yPercent: 100, duration: 0.35, ease: 'power2.inOut' }, 0.05);
  };

  // 4. Staggered Columns
  const runColumnsIn = (onComplete: () => void) => {
    const el = document.getElementById('fx-columns');
    const cols = document.querySelectorAll('.fx-col');
    const badge = document.getElementById('fx-col-badge');
    if (!el) return onComplete();

    hideAllFx();
    el.classList.remove('hidden');
    el.style.display = 'flex';

    gsap.killTweensOf([...cols, badge]);
    gsap.timeline({ onComplete })
      .fromTo(cols, { yPercent: -100 }, { yPercent: 0, duration: 0.28, stagger: 0.02, ease: 'power2.inOut' }, 0)
      .fromTo(badge, { opacity: 0, scale: 0.9 }, { opacity: 1, scale: 1, duration: 0.18, ease: 'power2.out' }, 0.1);
  };

  const runColumnsOut = (onComplete: () => void) => {
    const el = document.getElementById('fx-columns');
    const cols = document.querySelectorAll('.fx-col');
    const badge = document.getElementById('fx-col-badge');
    if (!el) return onComplete();

    hideAllFx();
    el.classList.remove('hidden');
    el.style.display = 'flex';
    gsap.killTweensOf([...cols, badge]);
    gsap.set(cols, { yPercent: 0 });
    if (badge) gsap.set(badge, { opacity: 1 });

    gsap.timeline({ onComplete })
      .to(badge, { opacity: 0, duration: 0.12 }, 0)
      .to(cols, { yPercent: 100, duration: 0.32, stagger: 0.02, ease: 'power2.inOut' }, 0.03);
  };

  // 5. Flash & Fade
  const runFlashIn = (onComplete: () => void) => {
    const el = document.getElementById('fx-flash');
    const burst = document.getElementById('fx-flash-burst');
    const content = document.getElementById('fx-flash-content');
    if (!el) return onComplete();

    hideAllFx();
    el.classList.remove('hidden');
    el.style.display = 'flex';

    gsap.killTweensOf([el, burst, content]);
    gsap.timeline({ onComplete })
      .set(el, { opacity: 1 })
      .fromTo(burst, { opacity: 0 }, { opacity: 1, duration: 0.1, ease: 'power1.out' }, 0)
      .to(burst, { opacity: 0, duration: 0.18, ease: 'power2.in' }, 0.1)
      .fromTo(content, { opacity: 0, scale: 0.95 }, { opacity: 1, scale: 1, duration: 0.18, ease: 'power2.out' }, 0.1);
  };

  const runFlashOut = (onComplete: () => void) => {
    const el = document.getElementById('fx-flash');
    const content = document.getElementById('fx-flash-content');
    if (!el) return onComplete();

    hideAllFx();
    el.classList.remove('hidden');
    el.style.display = 'flex';
    gsap.killTweensOf([el, content]);
    gsap.set(el, { opacity: 1 });
    if (content) gsap.set(content, { opacity: 1 });

    gsap.timeline({ onComplete })
      .to(content, { opacity: 0, duration: 0.12 }, 0)
      .to(el, { opacity: 0, duration: 0.3, ease: 'power2.out' }, 0.04);
  };

  const playIn = (style: string, cb: () => void) => {
    if (style === 'iris') runIrisIn(cb);
    else if (style === 'vertical') runVerticalIn(cb);
    else if (style === 'columns') runColumnsIn(cb);
    else if (style === 'flash') runFlashIn(cb);
    else runCurtainIn(cb);
  };

  const playOut = (style: string, cb: () => void) => {
    if (style === 'iris') runIrisOut(cb);
    else if (style === 'vertical') runVerticalOut(cb);
    else if (style === 'columns') runColumnsOut(cb);
    else if (style === 'flash') runFlashOut(cb);
    else runCurtainOut(cb);
  };

  // Hook into Astro ViewTransitions
  document.addEventListener('astro:before-preparation', (ev: any) => {
    const targetUrl = ev.to ? new URL(ev.to.href) : window.location;
    const targetStyle = getTransitionForPath(targetUrl.pathname);
    
    // Set persistent state on window
    (window as any).__mommentumNav = { isNavigating: true, style: targetStyle };

    const originalLoader = ev.loader;
    ev.loader = async () => {
      await new Promise<void>((resolve) => {
        if (overlay) {
          overlay.classList.remove('hidden');
          overlay.style.display = 'block';
        }
        playIn(targetStyle, () => resolve());
      });
      await originalLoader();
    };
  });

  document.addEventListener('astro:page-load', () => {
    const navState = (window as any).__mommentumNav;
    if (navState && navState.isNavigating && overlay) {
      navState.isNavigating = false;
      const currentStyle = navState.style || 'curtain';
      
      playOut(currentStyle, () => {
        overlay.classList.add('hidden');
        overlay.style.display = 'none';
      });
    } else {
      if (overlay) {
        overlay.classList.add('hidden');
        overlay.style.display = 'none';
      }
    }
  });
</script>
