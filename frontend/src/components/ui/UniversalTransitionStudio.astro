---
// Universal Transition Engine: Pure Seamless SPA DOM-Swapper (100% Zero-Flash & Dynamic Variety)
---

<!-- Transition Container Overlays -->
<div id="transition-studio-overlay" class="fixed inset-0 z-[9999999] pointer-events-none select-none overflow-hidden hidden">

  <!-- Style 1: Dual Horizontal Split Curtain (INICIO & ANTIGUA) -->
  <div id="fx-curtain" class="absolute inset-0 flex transition-fx hidden">
    <div id="fx-curtain-l" class="w-1/2 h-full bg-[#07080B] border-r border-white/20 flex items-center justify-end pr-4 shadow-[15px_0_30px_rgba(0,0,0,0.9)]" style="will-change: transform;">
      <div class="w-1 h-20 rounded-full bg-white/30"></div>
    </div>
    <div id="fx-curtain-r" class="w-1/2 h-full bg-[#07080B] border-l border-white/20 flex items-center justify-start pl-4 shadow-[-15px_0_30px_rgba(0,0,0,0.9)]" style="will-change: transform;">
      <div class="w-1 h-20 rounded-full bg-white/30"></div>
    </div>
    <div id="fx-curtain-badge" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 flex flex-col items-center opacity-0 z-20" style="will-change: transform, opacity;">
      <div class="w-12 h-12 rounded-full border border-white/20 bg-[#14161F]/90 backdrop-blur-md flex items-center justify-center mb-2">
        <span class="font-condensed text-xl font-bold text-white">M</span>
      </div>
      <span class="font-condensed text-3xl sm:text-4xl font-bold tracking-[0.25em] text-white uppercase drop-shadow-2xl">MOMMENTUM</span>
      <span class="font-mono text-[9px] text-graphite tracking-widest uppercase mt-1">CORTINA DUAL</span>
    </div>
  </div>

  <!-- Style 2: Camera Iris / Diafragma de Obturador (MUSEO 3D & ANDY) -->
  <div id="fx-iris" class="absolute inset-0 bg-[#07080B] transition-fx hidden flex items-center justify-center" style="clip-path: circle(0% at 50% 50%); will-change: clip-path;">
    <div id="fx-iris-content" class="flex flex-col items-center text-center opacity-0 z-20" style="will-change: transform, opacity;">
      <div class="w-16 h-16 rounded-full border-2 border-white/40 flex items-center justify-center mb-3">
        <div class="w-8 h-8 rounded-full border border-white/60"></div>
      </div>
      <span class="font-condensed text-3xl sm:text-5xl font-bold tracking-[0.3em] text-white uppercase drop-shadow-2xl">MOMMENTUM</span>
      <span class="font-mono text-[10px] text-silver tracking-[0.25em] uppercase mt-1.5">// DIAFRAGMA ÓPTICO f/1.4</span>
    </div>
  </div>

  <!-- Style 3: Vertical Curtain / Telón Cinemático (FOTÓGRAFOS & FAMILIA) -->
  <div id="fx-vertical" class="absolute inset-0 transition-fx hidden flex flex-col">
    <div id="fx-vert-top" class="w-full h-1/2 bg-[#07080B] border-b border-white/20 flex items-end justify-center pb-4 shadow-[0_15px_30px_rgba(0,0,0,0.9)]" style="will-change: transform;">
      <div class="w-24 h-1 rounded-full bg-white/30"></div>
    </div>
    <div id="fx-vert-bot" class="w-full h-1/2 bg-[#07080B] border-t border-white/20 flex items-start justify-center pt-4 shadow-[0_-15px_30px_rgba(0,0,0,0.9)]" style="will-change: transform;">
      <div class="w-24 h-1 rounded-full bg-white/30"></div>
    </div>
    <div id="fx-vert-badge" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 flex flex-col items-center opacity-0 z-20" style="will-change: transform, opacity;">
      <span class="font-condensed text-3xl sm:text-4xl font-bold tracking-[0.25em] text-white uppercase drop-shadow-2xl">MOMMENTUM</span>
      <span class="font-mono text-[10px] text-graphite tracking-widest uppercase mt-1">// TELÓN CINEMÁTICO</span>
    </div>
  </div>

  <!-- Style 4: Staggered Multi-Columns (PORTAFOLIO & CARAVANA) -->
  <div id="fx-columns" class="absolute inset-0 transition-fx hidden flex">
    <div class="fx-col flex-1 h-full bg-[#07080B] border-r border-white/10" style="will-change: transform;"></div>
    <div class="fx-col flex-1 h-full bg-[#0A0B10] border-r border-white/10" style="will-change: transform;"></div>
    <div class="fx-col flex-1 h-full bg-[#07080B] border-r border-white/10" style="will-change: transform;"></div>
    <div class="fx-col flex-1 h-full bg-[#0A0B10] border-r border-white/10" style="will-change: transform;"></div>
    <div class="fx-col flex-1 h-full bg-[#07080B]" style="will-change: transform;"></div>
    <div id="fx-col-badge" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 flex flex-col items-center opacity-0 z-20" style="will-change: transform, opacity;">
      <span class="font-condensed text-3xl sm:text-4xl font-bold tracking-[0.25em] text-white uppercase drop-shadow-2xl">MOMMENTUM</span>
      <span class="font-mono text-[10px] text-graphite tracking-widest uppercase mt-1">// COLUMNAS ESCALONADAS</span>
    </div>
  </div>

  <!-- Style 5: Camera Flash & Exposure Fade (QUIÉN SOY & RUBY) -->
  <div id="fx-flash" class="absolute inset-0 bg-[#07080B] transition-fx hidden flex items-center justify-center opacity-0" style="will-change: opacity;">
    <div id="fx-flash-burst" class="absolute inset-0 bg-white opacity-0 pointer-events-none" style="will-change: opacity;"></div>
    <div id="fx-flash-content" class="flex flex-col items-center text-center opacity-0 z-20" style="will-change: transform, opacity;">
      <span class="font-mono text-[10px] text-graphite tracking-[0.3em] uppercase mb-2">✦ DISPARO DE OBTURADOR</span>
      <span class="font-condensed text-3xl sm:text-4xl font-bold tracking-[0.25em] text-white uppercase drop-shadow-2xl">MOMMENTUM</span>
    </div>
  </div>

</div>

<script>
  import gsap from 'gsap';

  const overlay = document.getElementById('transition-studio-overlay');
  let isNavigating = false;
  const availableStyles = ['curtain', 'iris', 'vertical', 'columns', 'flash'];
  let lastUsedStyle = '';

  // Specific Signature Transition per Route + Non-Repeating Variety
  const getTransitionForPath = (path: string): string => {
    const p = path.toLowerCase();
    let style = 'curtain';

    if (p.includes('/museo')) {
      style = 'iris';
    } else if (p.includes('/fotografos')) {
      style = 'vertical';
    } else if (p === '/portafolio' || p === '/portafolio/') {
      style = 'columns';
    } else if (p.includes('/quien-soy')) {
      style = 'flash';
    } else if (p.includes('/creativo')) {
      style = 'vertical';
    } else if (p.includes('/mural')) {
      style = 'columns';
    } else if (p.includes('/portafolio/ruby')) {
      style = 'flash';
    } else if (p.includes('/portafolio/sesion-andy')) {
      style = 'iris';
    } else if (p.includes('/portafolio/antigua-guatemala')) {
      style = 'curtain';
    } else if (p.includes('/portafolio/caravana-del-zorro')) {
      style = 'columns';
    } else if (p.includes('/portafolio/familia-erick')) {
      style = 'vertical';
    } else if (p.includes('/portafolio/semana-santa')) {
      style = 'curtain';
    } else if (p.includes('/portafolio/sesion-embarazada')) {
      style = 'iris';
    } else {
      style = 'curtain';
    }

    // Never repeat the exact same transition twice consecutively!
    if (style === lastUsedStyle) {
      const remaining = availableStyles.filter(s => s !== lastUsedStyle);
      style = remaining[Math.floor(Math.random() * remaining.length)];
    }

    lastUsedStyle = style;
    return style;
  };

  const hideAllFx = () => {
    document.querySelectorAll('.transition-fx').forEach(el => {
      (el as HTMLElement).classList.add('hidden');
      (el as HTMLElement).style.display = 'none';
    });
  };

  // 1. Dual Curtain
  const runCurtainIn = (onComplete: () => void) => {
    const el = document.getElementById('fx-curtain');
    const cl = document.getElementById('fx-curtain-l');
    const cr = document.getElementById('fx-curtain-r');
    const badge = document.getElementById('fx-curtain-badge');
    if (!el || !cl || !cr) return onComplete();

    hideAllFx();
    el.classList.remove('hidden');
    el.style.display = 'flex';

    gsap.timeline({ onComplete })
      .fromTo(cl, { xPercent: -100 }, { xPercent: 0, duration: 0.45, ease: 'power3.inOut' }, 0)
      .fromTo(cr, { xPercent: 100 }, { xPercent: 0, duration: 0.45, ease: 'power3.inOut' }, 0)
      .fromTo(badge, { opacity: 0, scale: 0.85 }, { opacity: 1, scale: 1, duration: 0.3, ease: 'power2.out' }, 0.15);
  };

  const runCurtainOut = (onComplete: () => void) => {
    const el = document.getElementById('fx-curtain');
    const cl = document.getElementById('fx-curtain-l');
    const cr = document.getElementById('fx-curtain-r');
    const badge = document.getElementById('fx-curtain-badge');
    if (!el || !cl || !cr) return onComplete();

    gsap.timeline({ onComplete })
      .to(badge, { opacity: 0, scale: 0.9, duration: 0.25, ease: 'power2.in' }, 0)
      .to(cl, { xPercent: -100, duration: 0.5, ease: 'power3.inOut' }, 0.08)
      .to(cr, { xPercent: 100, duration: 0.5, ease: 'power3.inOut' }, 0.08);
  };

  // 2. Camera Iris
  const runIrisIn = (onComplete: () => void) => {
    const el = document.getElementById('fx-iris');
    const content = document.getElementById('fx-iris-content');
    if (!el) return onComplete();

    hideAllFx();
    el.classList.remove('hidden');
    el.style.display = 'flex';

    gsap.timeline({ onComplete })
      .fromTo(el, { clipPath: 'circle(0% at 50% 50%)' }, { clipPath: 'circle(150% at 50% 50%)', duration: 0.5, ease: 'power3.inOut' }, 0)
      .fromTo(content, { opacity: 0, scale: 0.8 }, { opacity: 1, scale: 1, duration: 0.3, ease: 'power2.out' }, 0.2);
  };

  const runIrisOut = (onComplete: () => void) => {
    const el = document.getElementById('fx-iris');
    const content = document.getElementById('fx-iris-content');
    if (!el) return onComplete();

    gsap.timeline({ onComplete })
      .to(content, { opacity: 0, scale: 1.1, duration: 0.2, ease: 'power2.in' }, 0)
      .to(el, { clipPath: 'circle(0% at 50% 50%)', duration: 0.5, ease: 'power3.inOut' }, 0.08);
  };

  // 3. Vertical Curtain
  const runVerticalIn = (onComplete: () => void) => {
    const el = document.getElementById('fx-vertical');
    const vt = document.getElementById('fx-vert-top');
    const vb = document.getElementById('fx-vert-bot');
    const badge = document.getElementById('fx-vert-badge');
    if (!el || !vt || !vb) return onComplete();

    hideAllFx();
    el.classList.remove('hidden');
    el.style.display = 'flex';

    gsap.timeline({ onComplete })
      .fromTo(vt, { yPercent: -100 }, { yPercent: 0, duration: 0.45, ease: 'power3.inOut' }, 0)
      .fromTo(vb, { yPercent: 100 }, { yPercent: 0, duration: 0.45, ease: 'power3.inOut' }, 0)
      .fromTo(badge, { opacity: 0, scale: 0.85 }, { opacity: 1, scale: 1, duration: 0.3, ease: 'power2.out' }, 0.15);
  };

  const runVerticalOut = (onComplete: () => void) => {
    const el = document.getElementById('fx-vertical');
    const vt = document.getElementById('fx-vert-top');
    const vb = document.getElementById('fx-vert-bot');
    const badge = document.getElementById('fx-vert-badge');
    if (!el || !vt || !vb) return onComplete();

    gsap.timeline({ onComplete })
      .to(badge, { opacity: 0, scale: 0.9, duration: 0.25, ease: 'power2.in' }, 0)
      .to(vt, { yPercent: -100, duration: 0.5, ease: 'power3.inOut' }, 0.08)
      .to(vb, { yPercent: 100, duration: 0.5, ease: 'power3.inOut' }, 0.08);
  };

  // 4. Staggered Columns
  const runColumnsIn = (onComplete: () => void) => {
    const el = document.getElementById('fx-columns');
    const cols = document.querySelectorAll('.fx-col');
    const badge = document.getElementById('fx-col-badge');
    if (!el) return onComplete();

    hideAllFx();
    el.classList.remove('hidden');
    el.style.display = 'flex';

    gsap.timeline({ onComplete })
      .fromTo(cols, { yPercent: -100 }, { yPercent: 0, duration: 0.4, stagger: 0.04, ease: 'power3.inOut' }, 0)
      .fromTo(badge, { opacity: 0, scale: 0.85 }, { opacity: 1, scale: 1, duration: 0.25, ease: 'power2.out' }, 0.18);
  };

  const runColumnsOut = (onComplete: () => void) => {
    const el = document.getElementById('fx-columns');
    const cols = document.querySelectorAll('.fx-col');
    const badge = document.getElementById('fx-col-badge');
    if (!el) return onComplete();

    gsap.timeline({ onComplete })
      .to(badge, { opacity: 0, duration: 0.2 }, 0)
      .to(cols, { yPercent: 100, duration: 0.45, stagger: 0.04, ease: 'power3.inOut' }, 0.05);
  };

  // 5. Flash & Fade
  const runFlashIn = (onComplete: () => void) => {
    const el = document.getElementById('fx-flash');
    const burst = document.getElementById('fx-flash-burst');
    const content = document.getElementById('fx-flash-content');
    if (!el) return onComplete();

    hideAllFx();
    el.classList.remove('hidden');
    el.style.display = 'flex';

    gsap.timeline({ onComplete })
      .set(el, { opacity: 1 })
      .fromTo(burst, { opacity: 0 }, { opacity: 1, duration: 0.18, ease: 'power1.out' }, 0)
      .to(burst, { opacity: 0, duration: 0.25, ease: 'power2.in' }, 0.18)
      .fromTo(content, { opacity: 0, scale: 0.9 }, { opacity: 1, scale: 1, duration: 0.25, ease: 'power2.out' }, 0.18);
  };

  const runFlashOut = (onComplete: () => void) => {
    const el = document.getElementById('fx-flash');
    const content = document.getElementById('fx-flash-content');
    if (!el) return onComplete();

    gsap.timeline({ onComplete })
      .to(content, { opacity: 0, duration: 0.2 }, 0)
      .to(el, { opacity: 0, duration: 0.45, ease: 'power2.out' }, 0.08);
  };

  const playIn = (style: string, cb: () => void) => {
    if (style === 'iris') runIrisIn(cb);
    else if (style === 'vertical') runVerticalIn(cb);
    else if (style === 'columns') runColumnsIn(cb);
    else if (style === 'flash') runFlashIn(cb);
    else runCurtainIn(cb);
  };

  const playOut = (style: string, cb: () => void) => {
    if (style === 'iris') runIrisOut(cb);
    else if (style === 'vertical') runVerticalOut(cb);
    else if (style === 'columns') runColumnsOut(cb);
    else if (style === 'flash') runFlashOut(cb);
    else runCurtainOut(cb);
  };

  // Pure Seamless SPA Router (100% Zero-Flash, in-memory swap)
  const seamlessNavigate = async (href: string) => {
    if (isNavigating || !overlay) return;
    isNavigating = true;

    const targetStyle = getTransitionForPath(href);
    overlay.classList.remove('hidden');
    overlay.style.display = 'block';

    const [fetchPromise] = [
      fetch(href).then(res => res.text()).catch(() => null),
    ];

    playIn(targetStyle, async () => {
      const htmlText = await fetchPromise;

      if (!htmlText) {
        window.location.href = href;
        return;
      }

      const parser = new DOMParser();
      const newDoc = parser.parseFromString(htmlText, 'text/html');

      const newMain = newDoc.querySelector('main');
      const currentMain = document.querySelector('main');

      if (newMain && currentMain) {
        currentMain.innerHTML = newMain.innerHTML;
        document.title = newDoc.title;
        window.history.pushState({}, '', href);
        window.scrollTo(0, 0);

        // Execute dynamic scripts in the new page
        const scripts = newMain.querySelectorAll('script');
        scripts.forEach(oldScript => {
          const newScript = document.createElement('script');
          Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
          newScript.textContent = oldScript.textContent;
          document.body.appendChild(newScript);
          newScript.remove();
        });

        window.dispatchEvent(new CustomEvent('page-transition-done'));
      } else {
        window.location.href = href;
        return;
      }

      setTimeout(() => {
        playOut(targetStyle, () => {
          overlay.classList.add('hidden');
          overlay.style.display = 'none';
          isNavigating = false;
        });
      }, 80);
    });
  };

  // Intercept navigation links
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('a');
    if (!target) return;

    const href = target.getAttribute('href');
    if (!href) return;

    if (
      href.startsWith('/') && 
      !href.startsWith('#') && 
      !href.includes('replay=') && 
      !target.getAttribute('target') &&
      href !== window.location.pathname
    ) {
      e.preventDefault();
      seamlessNavigate(href);
    }
  });

  window.addEventListener('popstate', () => {
    seamlessNavigate(window.location.pathname);
  });
</script>
