---
// Global Photographic Shutter Blade Page Transition Effect
---

<div id="shutter-transition-overlay" class="fixed inset-0 z-[99998] pointer-events-none opacity-0 flex items-center justify-center bg-[#07080A] transition-opacity duration-300">
  <!-- Mechanical Iris Aperture SVG -->
  <div class="relative w-72 h-72 sm:w-96 sm:h-96 rounded-full border border-white/15 flex items-center justify-center overflow-hidden">
    <svg id="page-shutter-svg" class="w-full h-full transform origin-center transition-transform duration-500" viewBox="0 0 400 400">
      <g id="page-shutter-blades" class="origin-center transition-all duration-500">
        <path d="M200,20 L320,120 L240,240 L160,180 Z" fill="#0E1015" stroke="rgba(255,255,255,0.25)" stroke-width="1" />
        <path d="M320,120 L380,240 L260,320 L200,240 Z" fill="#14161C" stroke="rgba(255,255,255,0.25)" stroke-width="1" />
        <path d="M380,240 L280,360 L160,320 L220,240 Z" fill="#0E1015" stroke="rgba(255,255,255,0.25)" stroke-width="1" />
        <path d="M280,360 L160,380 L120,260 L200,220 Z" fill="#14161C" stroke="rgba(255,255,255,0.25)" stroke-width="1" />
        <path d="M160,380 L40,280 L120,160 L180,220 Z" fill="#0E1015" stroke="rgba(255,255,255,0.25)" stroke-width="1" />
        <path d="M40,280 L20,160 L140,80 L180,180 Z" fill="#14161C" stroke="rgba(255,255,255,0.25)" stroke-width="1" />
        <path d="M20,160 L120,40 L240,80 L180,180 Z" fill="#0E1015" stroke="rgba(255,255,255,0.25)" stroke-width="1" />
        <path d="M120,40 L240,20 L280,140 L200,180 Z" fill="#14161C" stroke="rgba(255,255,255,0.25)" stroke-width="1" />
      </g>
      <circle cx="200" cy="200" r="10" fill="#FFFFFF" opacity="0.8" />
    </svg>
  </div>
</div>

<script>
  import gsap from 'gsap';

  const overlay = document.getElementById('shutter-transition-overlay');
  const blades = document.getElementById('page-shutter-blades');

  // Open shutter on page load
  const openShutter = () => {
    if (!overlay || !blades) return;
    gsap.fromTo(blades, { scale: 0.1, rotation: 0 }, { scale: 2.2, rotation: 90, duration: 0.45, ease: 'power2.out' });
    gsap.to(overlay, { opacity: 0, duration: 0.45, ease: 'power2.out', onComplete: () => {
      overlay.style.pointerEvents = 'none';
    }});
  };

  // Close shutter on internal page navigation
  const closeShutterAndNavigate = (href: string) => {
    if (!overlay || !blades) {
      window.location.href = href;
      return;
    }
    overlay.style.pointerEvents = 'auto';
    gsap.to(overlay, { opacity: 1, duration: 0.35, ease: 'power2.in' });
    gsap.fromTo(blades, { scale: 2.2, rotation: 90 }, { scale: 0.1, rotation: 0, duration: 0.35, ease: 'power2.in', onComplete: () => {
      window.location.href = href;
    }});
  };

  openShutter();

  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('a');
    if (!target) return;

    const href = target.getAttribute('href');
    if (!href) return;

    // Only intercept internal relative page transitions
    if (
      href.startsWith('/') && 
      !href.startsWith('#') && 
      !href.includes('replay=') && 
      !target.getAttribute('target') &&
      href !== window.location.pathname
    ) {
      e.preventDefault();
      closeShutterAndNavigate(href);
    }
  });
</script>
