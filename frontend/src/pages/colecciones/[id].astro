---
import Layout from '../../layouts/Layout.astro';
import { SERIES_LIST } from '../../data/portfolio';

export async function getStaticPaths() {
  return SERIES_LIST.map((series) => ({
    params: { id: series.id },
    props: { series },
  }));
}

const { series } = Astro.props;

// Find next series for navigation
const currentIndex = SERIES_LIST.findIndex(s => s.id === series.id);
const nextSeries = SERIES_LIST[(currentIndex + 1) % SERIES_LIST.length];
---

<Layout title={`${series.title} | Serie ${series.number} • MOMMENTUM`} description={series.description}>
  <div class="pt-36 pb-32 bg-obsidian text-pure">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      
      <!-- Back Breadcrumbs -->
      <div class="flex items-center gap-3 font-mono text-xs text-graphite mb-10">
        <a href="/colecciones" class="hover:text-pure transition-colors">← SALAS DE EXPOSICIÓN</a>
        <span>/</span>
        <span class="text-silver">SERIE {series.number}</span>
      </div>

      <!-- Series Master Hero Header -->
      <div class="border-b border-white/10 pb-16 mb-20">
        <div class="flex items-center gap-4 font-mono text-xs text-graphite uppercase mb-3">
          <span class="px-2.5 py-1 bg-pure text-obsidian font-bold rounded">SERIE {series.number}</span>
          <span>AÑO {series.year}</span>
          <span>•</span>
          <span>{series.location}</span>
          <span>•</span>
          <span>{series.photos.length} OBRAS EN SALA</span>
        </div>

        <h1 class="font-condensed text-5xl sm:text-7xl md:text-8xl lg:text-9xl uppercase font-bold tracking-tight text-pure mt-4 leading-[0.9]">
          {series.title}
        </h1>

        <p class="font-mono text-sm md:text-base text-silver tracking-widest uppercase mt-6">
          // {series.tagline}
        </p>

        <!-- Curator & Concept Statement -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mt-12 pt-8 border-t border-white/5">
          <div class="lg:col-span-4 font-mono text-xs text-graphite">
            <span class="text-pure uppercase font-bold block mb-2">DECLARACIÓN CURATORIAL</span>
            <p>Texto de sala curado por Anita (CMO & Dirección de Voz)</p>
          </div>
          <div class="lg:col-span-8 font-body text-base md:text-lg text-silver/90 leading-relaxed">
            <p class="mb-4">{series.description}</p>
            <blockquote class="pl-4 border-l border-white/20 italic text-silver/70">
              "{series.curatorNote}"
            </blockquote>
          </div>
        </div>
      </div>

      <!-- Curated Artwork Wall (Museum Layout) -->
      <div class="space-y-28">
        {series.photos.map((photo, idx) => (
          <div 
            class={`grid grid-cols-1 lg:grid-cols-12 gap-12 items-center photo-card cursor-pointer group`}
            data-photo-id={photo.id}
            data-pillar={photo.pillar}
            data-cursor="view"
          >
            <!-- Image Column -->
            <div class={`lg:col-span-7 ${idx % 2 === 1 ? 'lg:order-2' : 'lg:order-1'}`}>
              <div class="relative aspect-[4/5] rounded overflow-hidden bg-carbon border border-white/10 shadow-2xl">
                <img 
                  src={photo.imageUrl} 
                  alt={photo.title}
                  class="w-full h-full object-cover filter grayscale contrast-125 group-hover:grayscale-0 transition-all duration-700 group-hover:scale-105"
                  loading="lazy"
                />
                
                <div class="absolute top-4 left-4 font-mono text-[10px] text-silver bg-obsidian/80 backdrop-blur-md px-3 py-1 rounded border border-white/10">
                  FOTOGRAMA {photo.frameNumber}
                </div>

                <div class="absolute bottom-4 right-4 font-mono text-[10px] text-pure bg-obsidian/80 backdrop-blur-md px-3 py-1 rounded border border-white/10 flex items-center gap-2">
                  <span>AMPLIAR FICHA</span>
                  <span>🔍</span>
                </div>
              </div>
            </div>

            <!-- Metadata & Technical Info Column -->
            <div class={`lg:col-span-5 ${idx % 2 === 1 ? 'lg:order-1' : 'lg:order-2'} flex flex-col justify-between`}>
              <div>
                <span class="font-mono text-xs text-graphite uppercase tracking-widest block mb-2">
                  OBRA {idx + 1} DE {series.photos.length} • {photo.pillarLabel}
                </span>

                <h3 class="font-condensed text-3xl sm:text-4xl md:text-5xl font-bold uppercase text-pure group-hover:text-silver transition-colors">
                  {photo.title}
                </h3>

                <p class="font-body text-sm md:text-base text-silver/80 mt-6 leading-relaxed">
                  {photo.concept}
                </p>

                {photo.edition && (
                  <p class="font-mono text-xs text-graphite mt-4">
                    // TIRADA: <span class="text-silver">{photo.edition}</span>
                  </p>
                )}

                {photo.dimensions && (
                  <p class="font-mono text-xs text-graphite mt-1">
                    // FORMATO FÍSICO: <span class="text-silver">{photo.dimensions}</span>
                  </p>
                )}
              </div>

              <!-- Compact Technical EXIF Box -->
              <div class="mt-8 p-5 rounded bg-carbon/80 border border-white/10 font-mono text-xs text-graphite space-y-2">
                <div class="flex justify-between border-b border-white/5 pb-2">
                  <span>SISTEMA / CÁMARA:</span>
                  <span class="text-pure">{photo.exif.camera}</span>
                </div>
                <div class="flex justify-between border-b border-white/5 pb-2">
                  <span>ÓPTICA:</span>
                  <span class="text-pure">{photo.exif.lens}</span>
                </div>
                <div class="flex justify-between">
                  <span>PARÁMETROS:</span>
                  <span class="text-silver">{photo.exif.aperture} • {photo.exif.shutterSpeed} • {photo.exif.iso}</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Bottom Next Series Navigator -->
      <div class="mt-32 pt-16 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <span class="font-mono text-xs text-graphite uppercase block mb-1">CONTINUAR RECORRIDO</span>
          <span class="font-condensed text-2xl uppercase font-bold text-pure">SIGUIENTE SALA DE EXPOSICIÓN</span>
        </div>

        <a 
          href={`/colecciones/${nextSeries.id}`} 
          class="px-8 py-4 bg-pure text-obsidian hover:bg-gallery font-condensed tracking-widest text-xs uppercase font-bold transition-all flex items-center gap-3 hover:scale-95"
          data-cursor="explore"
        >
          <span>SERIE {nextSeries.number}: {nextSeries.title}</span>
          <span>→</span>
        </a>
      </div>

    </div>
  </div>
</Layout>
