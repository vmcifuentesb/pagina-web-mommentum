---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CREATOR } from '../data/creator';
---

<BaseLayout title="Quién Soy // Victor Cifuentes">
  
  <section class="w-full min-h-screen pt-32 pb-28 px-6 md:px-12 bg-obsidian text-pure">
    <div class="w-full mx-auto">
      
      <!-- Section Header Full Width -->
      <div class="border-b border-white/10 pb-8 mb-12 flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <a href="/" class="font-mono text-xs text-graphite hover:text-white mb-2 block" data-cursor="pointer">← VOLVER AL INICIO</a>
          <span class="font-mono text-xs text-graphite tracking-[0.25em] uppercase">// PERFIL</span>
          <h1 class="font-condensed text-5xl sm:text-7xl md:text-8xl font-bold uppercase tracking-tight text-pure mt-2">
            VICTOR CIFUENTES.
          </h1>
        </div>
        <p class="font-mono text-sm text-silver/80">
          {CREATOR.tagline}
        </p>
      </div>

      <!-- Minimalist Layout Full Width -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        <!-- Large Portrait Photo -->
        <div class="lg:col-span-5">
          <div class="relative w-full aspect-[4/5] rounded-2xl overflow-hidden bg-carbon border border-white/15 shadow-2xl group">
            <img 
              src={CREATOR.portraitUrl} 
              alt={CREATOR.name} 
              class="w-full h-full object-cover filter contrast-110 group-hover:scale-105 transition-transform duration-700" 
              data-lightbox-photo
              data-title="Victor Cifuentes"
              data-copy="Fotografías y Momentos"
              data-album="PERFIL"
              data-cursor="view"
            />
            <div class="absolute bottom-4 left-4 bg-obsidian/90 backdrop-blur-md px-3 py-1.5 rounded font-mono text-[10px] text-silver border border-white/10">
              AUTOR
            </div>
          </div>
        </div>

        <!-- Description -->
        <div class="lg:col-span-7 space-y-6">
          <div>
            <h2 class="font-condensed text-3xl sm:text-4xl font-bold uppercase text-white mb-4">
              SOBRE MÍ & MIS FOTOGRAFÍAS
            </h2>
            <p class="font-body text-base sm:text-lg text-silver/90 leading-relaxed">
              {CREATOR.bio}
            </p>
          </div>

          <div class="space-y-3 text-silver/80 font-body text-sm leading-relaxed border-t border-white/10 pt-6">
            <p>
              Este sitio web es mi espacio personal para compartir las fotos que he tomado en diferentes lugares y momentos: desde viajes, paisajes y calles, hasta sesiones de retrato y momentos familiares.
            </p>
            <p>
              Cada álbum tiene una forma de visualización interactiva para explorar las fotografías a tu ritmo.
            </p>
          </div>

          <!-- Contact Details -->
          <div class="border-t border-white/10 pt-8 space-y-4 font-mono text-xs">
            <span class="text-white font-bold uppercase tracking-wider block">// CONTACTO</span>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-silver">
              <div>
                <span class="text-graphite block text-[10px]">UBICACIÓN:</span>
                <span class="text-pure font-bold">{CREATOR.location}</span>
              </div>
              <div>
                <span class="text-graphite block text-[10px]">CORREO:</span>
                <a href={`mailto:${CREATOR.email}`} class="text-pure font-bold hover:underline" data-cursor="pointer">
                  {CREATOR.email}
                </a>
              </div>
            </div>

            <div class="pt-6 flex flex-wrap items-center gap-4">
              <a 
                href={CREATOR.instagram} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="px-8 py-3.5 bg-pure text-obsidian font-condensed tracking-wider uppercase font-bold hover:bg-silver transition-all rounded text-sm"
                data-cursor="pointer"
              >
                INSTAGRAM @MOMMENTUM.ISES ↗
              </a>
              <a 
                href="/portafolio" 
                class="px-8 py-3.5 border border-white/20 hover:border-white font-condensed tracking-wider uppercase font-bold text-white transition-all rounded text-sm"
                data-cursor="pointer"
              >
                VER ÁLBUMES DE FOTOS →
              </a>
            </div>
          </div>

        </div>

      </div>

    </div>
  </section>

</BaseLayout>
