---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PHOTOGRAPHERS } from '../data/photographers';
import { ALL_PHOTOS } from '../data/albums';
---

<BaseLayout title="Fotógrafos & Catálogo de Obras // MOMMENTUM">
  
  <div class="pt-36 pb-32 bg-obsidian text-pure">
    <div class="w-full max-w-7xl mx-auto px-6 md:px-12">
      
      <!-- Catalog Header matching V1 -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-16 border-b border-white/10 pb-12">
        <div>
          <span class="font-mono text-xs tracking-[0.25em] text-graphite uppercase">// COMUNIDAD DE AUTOR</span>
          <h1 class="font-condensed text-5xl sm:text-7xl md:text-8xl uppercase font-bold tracking-tight text-pure mt-2 leading-none">
            FOTÓGRAFOS & OBRAS.
          </h1>
          <p class="font-body text-base text-silver/80 mt-4 max-w-xl">
            Colegas y directores de fotografía que colaboran con MOMMENTUM. Explora sus perfiles de autor y obras destacadas.
          </p>
        </div>

        <!-- Filter Controls -->
        <div class="flex flex-wrap items-center gap-2 font-mono text-[11px] uppercase tracking-wider">
          <button class="filter-photographer-btn active px-4 py-2 rounded bg-pure text-obsidian font-bold transition-all" data-filter="all" data-cursor="pointer">
            TODOS ({PHOTOGRAPHERS.length})
          </button>
          {PHOTOGRAPHERS.map((p) => (
            <button class="filter-photographer-btn px-4 py-2 rounded border border-white/10 text-graphite hover:text-pure hover:border-white/30 transition-all" data-filter={p.id} data-cursor="pointer">
              {p.name.split(' ')[0]}
            </button>
          ))}
        </div>
      </div>

      <!-- Photographers Profiles & Featured Works Grid -->
      <div id="photographers-grid" class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
        {PHOTOGRAPHERS.map((photographer) => (
          <article 
            class="photographer-card group bg-carbon rounded-lg overflow-hidden border border-white/10 hover:border-white transition-all duration-500 flex flex-col justify-between"
            data-author-id={photographer.id}
          >
            <div>
              <!-- Featured Work Image -->
              <div 
                class="relative aspect-[4/3] w-full overflow-hidden bg-obsidian cursor-pointer"
                data-lightbox-photo
                data-url={photographer.featuredShot}
                data-title={`Obra Destacada // ${photographer.name}`}
                data-copy={photographer.bio}
                data-album={photographer.role}
                data-cursor="view"
              >
                <img 
                  src={photographer.featuredShot} 
                  alt={photographer.name}
                  class="w-full h-full object-cover filter contrast-125 group-hover:scale-105 transition-transform duration-700" 
                />
                <div class="absolute top-3 right-3 bg-obsidian/85 px-2.5 py-1 rounded font-mono text-[9px] text-white border border-white/10">
                  OBRA DESTACADA
                </div>
              </div>

              <!-- Author Info -->
              <div class="p-6">
                <div class="flex items-center gap-4 mb-4">
                  <div class="w-12 h-12 rounded-full overflow-hidden border border-white/30 flex-shrink-0">
                    <img src={photographer.avatarUrl} alt={photographer.name} class="w-full h-full object-cover" />
                  </div>
                  <div>
                    <h3 class="font-condensed text-2xl font-bold uppercase text-white group-hover:text-silver transition-colors">
                      {photographer.name}
                    </h3>
                    <span class="font-mono text-[10px] text-graphite uppercase">{photographer.role}</span>
                  </div>
                </div>

                <p class="font-body text-xs text-silver/80 leading-relaxed mb-4">
                  {photographer.bio}
                </p>
                <div class="font-mono text-[10px] text-graphite">
                  ESPECIALIDAD: <span class="text-silver">{photographer.specialty}</span>
                </div>
              </div>
            </div>

            <!-- Card Footer -->
            <div class="p-6 pt-0 border-t border-white/5 mt-4 flex items-center justify-between font-mono text-xs">
              <span class="text-graphite">INSTAGRAM:</span>
              <a 
                href={photographer.instagram} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="text-white hover:underline font-bold"
                data-cursor="pointer"
              >
                {photographer.handle} ↗
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Additional Curatorial Works Feed matching V1 -->
      <div class="border-t border-white/10 pt-16">
        <div class="mb-8">
          <span class="font-mono text-xs text-graphite tracking-[0.25em] uppercase block">// CATÁLOGO GENERAL</span>
          <h2 class="font-condensed text-3xl sm:text-4xl font-bold uppercase text-white">
            OBRAS EN COLABORACIÓN.
          </h2>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6">
          {ALL_PHOTOS.slice(0, 8).map((photo) => (
            <div 
              class="group relative aspect-[3/4] rounded bg-carbon overflow-hidden border border-white/10 hover:border-white transition-all cursor-pointer"
              data-lightbox-photo
              data-url={photo.url}
              data-title={photo.title}
              data-copy={photo.anitaCopy}
              data-album="ARCHIVO DE OBRAS"
              data-shutter={photo.shutter}
              data-aperture={photo.aperture}
              data-iso={photo.iso}
              data-dim={photo.dimensions}
              data-cursor="view"
            >
              <img src={photo.url} alt={photo.title} class="w-full h-full object-cover filter contrast-125 group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-transparent to-transparent opacity-80 group-hover:opacity-30 transition-opacity"></div>
              <div class="absolute bottom-3 left-3 right-3 font-mono text-[9px] text-white truncate">
                {photo.title}
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>

</BaseLayout>

<script>
  import gsap from 'gsap';

  const filterBtns = document.querySelectorAll('.filter-photographer-btn');
  const cards = document.querySelectorAll('.photographer-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('active', 'bg-pure', 'text-obsidian', 'font-bold');
        b.classList.add('text-graphite', 'border-white/10');
      });
      btn.classList.add('active', 'bg-pure', 'text-obsidian', 'font-bold');
      btn.classList.remove('text-graphite', 'border-white/10');

      const filter = btn.getAttribute('data-filter');

      cards.forEach(card => {
        const authorId = card.getAttribute('data-author-id');
        if (filter === 'all' || authorId === filter) {
          gsap.to(card, {
            autoAlpha: 1,
            scale: 1,
            duration: 0.4,
            display: 'flex',
            ease: 'power2.out'
          });
        } else {
          gsap.to(card, {
            autoAlpha: 0,
            scale: 0.95,
            duration: 0.3,
            display: 'none',
            ease: 'power2.in'
          });
        }
      });
    });
  });
</script>
