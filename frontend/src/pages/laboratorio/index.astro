---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---

<Layout title="Laboratorio & Diario de Revelado | MOMMENTUM" description="Ensayos curatoriales, esquemas de iluminación de estudio, pruebas de emulsión y reflexiones de producción.">
  <div class="pt-36 pb-32 bg-obsidian text-pure">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      
      <!-- Header -->
      <div class="max-w-3xl mb-20 border-b border-white/10 pb-12">
        <span class="font-mono text-xs tracking-[0.25em] text-graphite uppercase">// CUADERNO DE PRODUCCIÓN & ENSAYOS</span>
        <h1 class="font-condensed text-5xl sm:text-7xl md:text-8xl uppercase font-bold tracking-tight text-pure mt-2 leading-none">
          LABORATORIO & JOURNAL.
        </h1>
        <p class="font-body text-base md:text-lg text-silver/80 mt-4 leading-relaxed">
          Documentamos la investigación técnica, las decisiones de óptica y las reflexiones filosóficas detrás de cada toma.
        </p>
      </div>

      <!-- Articles Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {sortedPosts.map((post) => (
          <article class="group bg-carbon p-8 md:p-12 rounded-xl border border-white/5 hover:border-white/20 transition-all duration-500 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between font-mono text-xs text-graphite mb-6">
                <span>{new Date(post.data.pubDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
                <span class="text-silver uppercase">AUTOR: {post.data.author}</span>
              </div>

              <h2 class="font-condensed text-3xl sm:text-4xl font-bold uppercase text-pure group-hover:text-silver transition-colors leading-tight">
                <a href={`/laboratorio/${post.slug}`} data-cursor="pointer">
                  {post.data.title}
                </a>
              </h2>

              <p class="font-body text-sm md:text-base text-silver/80 mt-6 leading-relaxed">
                {post.data.description}
              </p>
            </div>

            <div class="mt-12 pt-6 border-t border-white/5 flex items-center justify-between font-mono text-xs text-silver">
              <a href={`/laboratorio/${post.slug}`} class="flex items-center gap-2 hover:text-pure transition-colors" data-cursor="pointer">
                <span>LEER ENSAYO COMPLETO</span>
                <span class="group-hover:translate-x-2 transition-transform">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </div>
</Layout>
